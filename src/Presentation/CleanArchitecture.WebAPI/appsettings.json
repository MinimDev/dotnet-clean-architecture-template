{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "// NOTE FOR LINUX/MAC USERS": "Replace Trusted_Connection=True with User Id=sa;Password=Your_password123; if using Docker SQL Server",
    "// DefaultConnection_Linux": "Server=localhost;Database=CleanArchitectureDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "DefaultConnection": "Server=localhost;Database=CleanArchitectureDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "// IdentityConnection_Linux": "Server=localhost;Database=CleanArchitectureIdentityDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "IdentityConnection": "Server=localhost;Database=CleanArchitectureIdentityDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "// HangfireConnection_Linux": "Server=localhost;Database=CleanArchitectureHangfireDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "HangfireConnection": "Server=localhost;Database=CleanArchitectureHangfireDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyForJWTTokenGenerationChangeThisInProduction!@#$%",
    "Issuer": "CleanArchitecture.WebAPI",
    "Audience": "CleanArchitecture.Client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:7002",
      "https://localhost:7144",
      "http://localhost:5263"
    ]
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "PermitLimit": 100,
    "QueueLimit": 0,
    "Auth": {
      "WindowSeconds": 60,
      "PermitLimit": 10
    }
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "your-email@gmail.com",
    "Password": "your-app-password",
    "From": "your-email@gmail.com",
    "DisplayName": "Clean Architecture App"
  },
  "MassTransit": {
    "Enabled": true,
    "Transport": "InMemory",
    "// Transport options": "InMemory | RabbitMQ | ActiveMQ",
    "// InMemory": "Default. No external broker required. Suitable for local dev, testing, single-instance.",
    "// RabbitMQ": "Production/staging. Requires RabbitMQ server (see docker-compose.yml).",
    "// ActiveMQ": "Enterprise production. Requires ActiveMQ server.",
    "RabbitMQ": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest"
    },
    "ActiveMQ": {
      "Host": "localhost",
      "Port": 61616,
      "Username": "admin",
      "Password": "admin"
    }
  }
}