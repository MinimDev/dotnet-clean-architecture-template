@page "/audit-logs"
@using System.Text.Json
@using CleanArchitecture.WebUI.Services
@using CleanArchitecture.WebUI.Services.Models
@inject AuditLogsClient Client
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject TokenProvider TokenProvider

<AuthorizeView>
    <Authorized>
        @if (TokenProvider.HasPermission(Permissions.AuditLogs.View))
        {
            <div class="audit-logs-page">
                <!-- PageHeader Shared Component -->
                <PageHeader Title="Audit Trail"
                            Subtitle="Complete historical and immutable record of database modifications"
                            Icon="@Icons.Material.Rounded.HistoryEdu"
                            BadgeText="@($"{_totalItems} Events")">
                    <Actions>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="RefreshLogs" Class="rounded-lg" Size="Size.Small" Disabled="@_isLoading">
                            Refresh
                        </MudButton>
                        @if (HasActiveFilters)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.FilterAltOff"
                                       OnClick="ResetFilters" Class="rounded-lg" Size="Size.Small">
                                Reset Filters
                            </MudButton>
                        }
                    </Actions>
                </PageHeader>

                <!-- Filter Controls Panel -->
                <MudCard Elevation="0" Class="rounded-2xl mb-4 filter-card border-solid border-1"
                         Style="border-color: var(--mud-palette-lines-default); background: var(--mud-palette-surface);">
                    <MudCardContent Class="pa-3-5">
                        <MudGrid Spacing="3" Class="align-center">
                            <!-- Action Filter Chips -->
                            <MudItem xs="12" md="4">
                                <MudText Typo="Typo.caption" Class="font-weight-bold text-uppercase mb-1 d-block" Color="Color.Secondary" Style="font-size: 0.7rem; letter-spacing: 0.05em;">
                                    Action Type
                                </MudText>
                                <div class="d-flex gap-1 flex-wrap">
                                    <MudChip T="string" Color="@(string.IsNullOrEmpty(_selectedAction) ? Color.Primary : Color.Default)"
                                             Variant="@(string.IsNullOrEmpty(_selectedAction) ? Variant.Filled : Variant.Outlined)"
                                             Size="Size.Small" OnClick="@(() => FilterByAction(null))" Class="cursor-pointer font-weight-bold" Style="font-size: 0.72rem; height: 24px;">
                                        ALL
                                    </MudChip>
                                    <MudChip T="string" Color="Color.Success"
                                             Variant="@(_selectedAction == "Created" ? Variant.Filled : Variant.Outlined)"
                                             Size="Size.Small" OnClick="@(() => FilterByAction("Created"))" Class="cursor-pointer font-weight-bold" Style="font-size: 0.72rem; height: 24px;">
                                        CREATED
                                    </MudChip>
                                    <MudChip T="string" Color="Color.Warning"
                                             Variant="@(_selectedAction == "Updated" ? Variant.Filled : Variant.Outlined)"
                                             Size="Size.Small" OnClick="@(() => FilterByAction("Updated"))" Class="cursor-pointer font-weight-bold" Style="font-size: 0.72rem; height: 24px;">
                                        UPDATED
                                    </MudChip>
                                    <MudChip T="string" Color="Color.Error"
                                             Variant="@(_selectedAction == "Deleted" ? Variant.Filled : Variant.Outlined)"
                                             Size="Size.Small" OnClick="@(() => FilterByAction("Deleted"))" Class="cursor-pointer font-weight-bold" Style="font-size: 0.72rem; height: 24px;">
                                        DELETED
                                    </MudChip>
                                </div>
                            </MudItem>

                            <!-- Entity Name Filter -->
                            <MudItem xs="12" sm="6" md="3">
                                <MudSelect T="string" Label="Entity" Value="@_selectedEntity" ValueChanged="FilterByEntity"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="rounded-lg bg-surface" Clearable="true">
                                    <MudSelectItem Value="@((string?)null)">All Entities</MudSelectItem>
                                    <MudSelectItem Value="@("Product")">Product</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <!-- User Search -->
                            <MudItem xs="12" sm="6" md="3">
                                <MudTextField T="string" Value="@_userSearch" ValueChanged="OnUserSearchChanged"
                                              Placeholder="Search by user or ID..." Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.PersonSearch" IconSize="Size.Small"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                              Clearable="true" Class="rounded-lg bg-surface" Style="font-size: 0.85rem;" />
                            </MudItem>

                            <!-- Page Size Selector -->
                            <MudItem xs="12" sm="6" md="2">
                                <MudSelect T="int" Label="Per Page" Value="@_pageSize" ValueChanged="OnPageSizeChanged"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="rounded-lg bg-surface">
                                    <MudSelectItem Value="5">5</MudSelectItem>
                                    <MudSelectItem Value="10">10</MudSelectItem>
                                    <MudSelectItem Value="25">25</MudSelectItem>
                                    <MudSelectItem Value="50">50</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>

                        @if (HasActiveFilters)
                        {
                            <MudDivider Class="my-3" />
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">Active filters:</MudText>
                                @if (!string.IsNullOrEmpty(_selectedAction))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(() => FilterByAction(null))" Class="font-weight-bold" Style="height: 22px;">
                                        Action: @_selectedAction
                                    </MudChip>
                                }
                                @if (!string.IsNullOrEmpty(_selectedEntity))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" OnClose="@(() => FilterByEntity(null))" Class="font-weight-bold" Style="height: 22px;">
                                        Entity: @_selectedEntity
                                    </MudChip>
                                }
                                @if (!string.IsNullOrEmpty(_userSearch))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" OnClose="@(() => OnUserSearchChanged(string.Empty))" Class="font-weight-bold" Style="height: 22px;">
                                        User: @_userSearch
                                    </MudChip>
                                }
                            </div>
                        }
                    </MudCardContent>
                </MudCard>

                <!-- Audit Log Records List -->
                @if (_isLoading)
                {
                    <TableSkeleton Rows="5" Columns="4" />
                }
                else if (_auditLogs == null || !_auditLogs.Any())
                {
                    <EmptyState Title="No Audit Logs Found"
                                Description="@(HasActiveFilters ? "No audit records match your specified filter criteria." : "No database modifications have been logged in the system yet.")"
                                Icon="@Icons.Material.Rounded.HistoryToggleOff"
                                ActionText="@(HasActiveFilters ? "Reset Filters" : "Refresh")"
                                ActionIcon="@(HasActiveFilters ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.Refresh)"
                                OnActionClick="@(HasActiveFilters ? ResetFilters : RefreshLogs)" />
                }
                else
                {
                    <div class="timeline-container d-flex flex-column gap-3">
                        @foreach (var log in _auditLogs)
                        {
                            var isExpanded = _expandedLogIds.Contains(log.Id);
                            var actionColor = GetActionColor(log.Action);
                            var actionIcon = GetActionIcon(log.Action);

                            <MudCard Elevation="0" Class="rounded-2xl overflow-hidden audit-card hover-lift border-solid border-1"
                                     Style="border-color: var(--mud-palette-lines-default); background: var(--mud-palette-surface);">
                                <div class="audit-card-accent-bar" style="@($"background-color: var(--mud-palette-{actionColor.ToString().ToLower()});")"></div>

                                <MudCardContent Class="pa-4">
                                    <!-- Top Row: Action Chip, Entity Name, Primary Key, and Timestamp -->
                                    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                                        <div class="d-flex align-center gap-2 flex-wrap">
                                            <MudChip T="string" Color="@actionColor" Size="Size.Small" Variant="Variant.Filled"
                                                     Icon="@actionIcon" Class="font-weight-bold shadow-sm" Style="font-size: 0.72rem; height: 22px;">
                                                @log.Action.ToUpper()
                                            </MudChip>
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined"
                                                     Icon="@Icons.Material.Filled.Category" Class="font-weight-bold" Style="font-size: 0.72rem; height: 22px;">
                                                @log.EntityName
                                            </MudChip>
                                            <div class="pk-badge d-flex align-center gap-1 px-2 py-0-5 rounded-lg border-solid border-1"
                                                 style="background: var(--mud-palette-background-grey); border-color: var(--mud-palette-lines-default);" title="Primary Key">
                                                <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.75rem;" />
                                                <code class="pk-code" style="font-size: 0.75rem;">@log.PrimaryKey</code>
                                            </div>
                                        </div>
                                        <div class="d-flex align-center gap-1-5">
                                            <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.85rem;" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-medium">
                                                @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC
                                            </MudText>
                                        </div>
                                    </div>

                                    <!-- Middle Row: User Details and Affected Columns -->
                                    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
                                        <div class="d-flex align-center gap-2">
                                            <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                                @((log.UserName ?? "S")[0].ToString().ToUpper())
                                            </MudAvatar>
                                            <div>
                                                <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                    @(string.IsNullOrEmpty(log.UserName) ? "System Service" : log.UserName)
                                                </MudText>
                                                @if (!string.IsNullOrEmpty(log.UserId))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block" Style="font-size: 0.72rem;">
                                                        ID: @log.UserId
                                                    </MudText>
                                                }
                                            </div>
                                        </div>

                                        @if (log.AffectedColumns != null && log.AffectedColumns.Any())
                                        {
                                            <div class="d-flex align-center gap-1 flex-wrap">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-1 font-weight-bold">Fields:</MudText>
                                                @foreach (var col in log.AffectedColumns.Take(5))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ma-0" Style="font-size: 0.72rem; height: 20px;">
                                                        @col
                                                    </MudChip>
                                                }
                                                @if (log.AffectedColumns.Length > 5)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Class="ma-0" Style="font-size: 0.72rem; height: 20px;">
                                                        +@(log.AffectedColumns.Length - 5) more
                                                    </MudChip>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Expand/Collapse Diff View Button -->
                                    @if (!string.IsNullOrEmpty(log.OldValues) || !string.IsNullOrEmpty(log.NewValues))
                                    {
                                        <div class="d-flex justify-end mt-2">
                                            <MudButton Variant="Variant.Text" Color="@actionColor" Size="Size.Small"
                                                       EndIcon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                       OnClick="@(() => ToggleExpand(log.Id))" Class="font-weight-bold text-transform-none" Style="font-size: 0.75rem;">
                                                @(isExpanded ? "Hide Side-by-Side Diff" : "View Side-by-Side Diff")
                                            </MudButton>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <MudDivider Class="my-3" />
                                            <div class="diff-container rounded-xl pa-3 mt-2 border-solid border-1"
                                                 style="border-color: var(--mud-palette-lines-default); background: var(--mud-palette-background-grey);">
                                                @{
                                                    var diffRows = ParseDiffRows(log.OldValues, log.NewValues);
                                                }
                                                @if (diffRows.Any())
                                                {
                                                    <MudSimpleTable Dense="true" Hover="true" Class="diff-table rounded-lg overflow-hidden">
                                                        <thead>
                                                            <tr>
                                                                <th style="width: 25%; font-weight: 700;">Property</th>
                                                                <th style="width: 37.5%; color: var(--mud-palette-error); font-weight: 700;">Old Value (Before)</th>
                                                                <th style="width: 37.5%; color: var(--mud-palette-success); font-weight: 700;">New Value (After)</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var row in diffRows)
                                                            {
                                                                <tr>
                                                                    <td class="font-weight-bold"><code>@row.Key</code></td>
                                                                    <td class="diff-old">
                                                                        @if (row.OldVal != null)
                                                                        {
                                                                            <span>@row.OldVal</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted fst-italic">null</span>
                                                                        }
                                                                    </td>
                                                                    <td class="diff-new">
                                                                        @if (row.NewVal != null)
                                                                        {
                                                                            <span>@row.NewVal</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted fst-italic">null</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </MudSimpleTable>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No property details available.</MudText>
                                                }
                                            </div>
                                        }
                                    }
                                </MudCardContent>
                            </MudCard>
                        }
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-center align-center mt-6 mb-4 gap-4 flex-wrap">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.8125rem;">
                            Showing @((_currentPage - 1) * _pageSize + 1) - @(Math.Min(_currentPage * _pageSize, _totalItems)) of @_totalItems entries
                        </MudText>
                        <MudPagination Color="Color.Primary" Count="@_totalPages" Selected="@_currentPage" SelectedChanged="OnPageChanged"
                                       ShowFirstButton="true" ShowLastButton="true" Variant="Variant.Filled" Class="rounded-xl shadow-sm" Size="Size.Small" />
                    </div>
                }
            </div>
        }
        else
        {
            <MudContainer MaxWidth="MaxWidth.Small" Class="mt-12 text-center">
                <MudPaper Class="pa-8 rounded-2xl" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Large" Color="Color.Warning" Class="mb-3" />
                    <MudText Typo="Typo.h5" Color="Color.Warning" Class="font-weight-bold mb-2">Permission Required</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        You require 'Permissions.AuditLogs.View' permission to view immutable audit trail logs.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="rounded-lg px-6">
                        Return to Dashboard
                    </MudButton>
                </MudPaper>
            </MudContainer>
        }
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-12 text-center">
            <MudPaper Class="pa-8 rounded-2xl" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Error" Class="mb-3" />
                <MudText Typo="Typo.h5" Color="Color.Error" Class="font-weight-bold mb-2">Sign In Required</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Please sign in to access audit trail logs.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" Class="rounded-lg px-6">
                    Sign In
                </MudButton>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

<style>
    .audit-card {
        position: relative;
    }
    .audit-card-accent-bar {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        width: 4px;
    }
    .diff-old {
        background: rgba(239, 68, 68, 0.08);
        color: var(--mud-palette-error);
        text-decoration: line-through;
        font-family: monospace;
        font-size: 0.82rem;
    }
    .diff-new {
        background: rgba(16, 185, 129, 0.08);
        color: var(--mud-palette-success);
        font-weight: 600;
        font-family: monospace;
        font-size: 0.82rem;
    }
</style>

@code {
    private List<AuditLogDto> _auditLogs = new();
    private bool _isLoading = true;
    private HashSet<Guid> _expandedLogIds = new();

    // Filters
    private string? _selectedAction;
    private string? _selectedEntity;
    private string? _userSearch;

    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private int _totalItems = 0;

    private bool HasActiveFilters => !string.IsNullOrEmpty(_selectedAction) ||
                                     !string.IsNullOrEmpty(_selectedEntity) ||
                                     !string.IsNullOrEmpty(_userSearch);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAuditLogs();
        }
    }

    private async Task LoadAuditLogs()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await Client.GetAuditLogsAsync(
            pageNumber: _currentPage,
            pageSize: _pageSize,
            entityName: _selectedEntity,
            action: _selectedAction,
            userId: _userSearch);

        if (result.IsSuccess && result.Data != null)
        {
            _auditLogs = result.Data.Items.ToList();
            _totalItems = result.Data.TotalCount;
            _totalPages = (int)Math.Ceiling((double)_totalItems / _pageSize);
            if (_totalPages == 0) _totalPages = 1;
        }
        else
        {
            _auditLogs = new List<AuditLogDto>();
            _totalPages = 1;
            if (!string.IsNullOrEmpty(result.Error))
            {
                Snackbar.Add($"Failed to load audit logs: {result.Error}", Severity.Error);
            }
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task FilterByAction(string? action)
    {
        _selectedAction = action;
        _currentPage = 1;
        await LoadAuditLogs();
    }

    private async Task FilterByEntity(string? entity)
    {
        _selectedEntity = entity;
        _currentPage = 1;
        await LoadAuditLogs();
    }

    private async Task OnUserSearchChanged(string text)
    {
        _userSearch = text;
        _currentPage = 1;
        await LoadAuditLogs();
    }

    private async Task OnPageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _currentPage = 1;
        await LoadAuditLogs();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadAuditLogs();
    }

    private async Task RefreshLogs()
    {
        await LoadAuditLogs();
    }

    private async Task ResetFilters()
    {
        _selectedAction = null;
        _selectedEntity = null;
        _userSearch = null;
        _currentPage = 1;
        await LoadAuditLogs();
    }

    private void ToggleExpand(Guid logId)
    {
        if (_expandedLogIds.Contains(logId))
        {
            _expandedLogIds.Remove(logId);
        }
        else
        {
            _expandedLogIds.Add(logId);
        }
    }

    private Color GetActionColor(string action) => action switch
    {
        "Created" => Color.Success,
        "Updated" => Color.Warning,
        "Deleted" => Color.Error,
        _ => Color.Default
    };

    private string GetActionIcon(string action) => action switch
    {
        "Created" => Icons.Material.Filled.AddCircle,
        "Updated" => Icons.Material.Filled.Edit,
        "Deleted" => Icons.Material.Filled.Delete,
        _ => Icons.Material.Filled.Info
    };

    private record DiffRow(string Key, string? OldVal, string? NewVal);

    private List<DiffRow> ParseDiffRows(string? oldJson, string? newJson)
    {
        var rows = new List<DiffRow>();
        Dictionary<string, JsonElement>? oldDict = null;
        Dictionary<string, JsonElement>? newDict = null;

        try
        {
            if (!string.IsNullOrEmpty(oldJson))
                oldDict = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(oldJson);
        }
        catch { }

        try
        {
            if (!string.IsNullOrEmpty(newJson))
                newDict = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(newJson);
        }
        catch { }

        var allKeys = new HashSet<string>();
        if (oldDict != null) foreach (var k in oldDict.Keys) allKeys.Add(k);
        if (newDict != null) foreach (var k in newDict.Keys) allKeys.Add(k);

        foreach (var key in allKeys.OrderBy(k => k))
        {
            string? oldVal = null;
            string? newVal = null;

            if (oldDict != null && oldDict.TryGetValue(key, out var oldEl))
                oldVal = FormatJsonElement(oldEl);

            if (newDict != null && newDict.TryGetValue(key, out var newEl))
                newVal = FormatJsonElement(newEl);

            rows.Add(new DiffRow(key, oldVal, newVal));
        }

        return rows;
    }

    private string FormatJsonElement(JsonElement el) => el.ValueKind switch
    {
        JsonValueKind.String => el.GetString() ?? "",
        JsonValueKind.Number => el.GetRawText(),
        JsonValueKind.True => "true",
        JsonValueKind.False => "false",
        JsonValueKind.Null => "null",
        _ => el.GetRawText()
    };
}
