@page "/"
@using CleanArchitecture.WebUI.Services
@using CleanArchitecture.WebUI.Services.Models
@inject TokenProvider TokenProvider
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard - Clean Architecture Template</PageTitle>

<div class="mb-6">
    <!-- Hero Banner Card -->
    <MudPaper Elevation="0" Class="pa-6 pa-md-8 rounded-2xl glass-panel position-relative overflow-hidden mb-6" 
              Style="background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(124, 58, 237, 0.04) 100%);">
        <div class="position-absolute" style="top: -20px; right: -20px; opacity: 0.08; pointer-events: none;">
            <MudIcon Icon="@Icons.Material.Filled.Layers" Style="font-size: 240px; color: var(--mud-palette-primary);" />
        </div>

        <div class="d-flex flex-column flex-md-row justify-space-between align-start align-md-center gap-4 position-relative">
            <div>
                <div class="d-inline-flex align-center gap-2 status-pill mb-3" style="background: rgba(var(--mud-palette-primary-rgb), 0.12); color: var(--mud-palette-primary);">
                    <span class="pulse-dot pulse-primary"></span>
                    <span>Clean Architecture Solution Template · v1.7.0 GA</span>
                </div>
                <MudText Typo="Typo.h3" Class="font-weight-bold mb-2 text-gradient-primary" Style="letter-spacing: -0.02em;">
                    Welcome back, @(_userName ?? "Developer")!
                </MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="max-width: 680px;">
                    Enterprise solution starter implementing Clean Architecture principles with .NET 10, Blazor Server, MediatR CQRS, and Permission-Based Access Control (PBAC).
                </MudText>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Inventory2"
                           OnClick='() => NavigationManager.NavigateTo("products")' Class="rounded-xl px-4 py-2 hover-lift">
                    View Products
                </MudButton>
                @if (TokenProvider.Roles.Contains("Admin"))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.AdminPanelSettings"
                               OnClick='() => NavigationManager.NavigateTo("users")' Class="rounded-xl px-4 py-2 hover-lift">
                        PBAC Matrix
                    </MudButton>
                }
            </div>
        </div>
    </MudPaper>

    <!-- Key Metrics / KPI Grid -->
    <MudGrid Spacing="4" Class="mb-6">
        <!-- Metric 1: PBAC & Identity -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Class="rounded-2xl glass-panel pa-5 hover-lift h-100">
                <div class="d-flex align-center justify-space-between mb-4">
                    <div class="icon-box icon-box-primary">
                        <MudIcon Icon="@Icons.Material.Rounded.Security" Size="Size.Medium" />
                    </div>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">
                        PBAC Active
                    </MudChip>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase font-weight-bold">Access Control</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold my-1">14 Permissions</MudText>
                <div class="d-flex align-center gap-1 mt-2">
                    <MudIcon Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Dynamic policy provider</MudText>
                </div>
            </MudCard>
        </MudItem>

        <!-- Metric 2: Products & Catalog -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Class="rounded-2xl glass-panel pa-5 hover-lift h-100">
                <div class="d-flex align-center justify-space-between mb-4">
                    <div class="icon-box icon-box-success">
                        <MudIcon Icon="@Icons.Material.Rounded.Inventory2" Size="Size.Medium" />
                    </div>
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">
                        Output Cache
                    </MudChip>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase font-weight-bold">Catalog Domain</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold my-1">CQRS Pipeline</MudText>
                <div class="d-flex align-center gap-1 mt-2">
                    <MudIcon Icon="@Icons.Material.Rounded.ElectricBolt" Color="Color.Warning" Size="Size.Small" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Idempotency-Key guarded</MudText>
                </div>
            </MudCard>
        </MudItem>

        <!-- Metric 3: Audit Trail -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Class="rounded-2xl glass-panel pa-5 hover-lift h-100">
                <div class="d-flex align-center justify-space-between mb-4">
                    <div class="icon-box icon-box-warning">
                        <MudIcon Icon="@Icons.Material.Rounded.HistoryEdu" Size="Size.Medium" />
                    </div>
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">
                        100% Tracked
                    </MudChip>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase font-weight-bold">Data Integrity</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold my-1">Audit Trail</MudText>
                <div class="d-flex align-center gap-1 mt-2">
                    <MudIcon Icon="@Icons.Material.Rounded.Difference" Color="Color.Info" Size="Size.Small" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Side-by-side JSON diffs</MudText>
                </div>
            </MudCard>
        </MudItem>

        <!-- Metric 4: Messaging & Jobs -->
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Class="rounded-2xl glass-panel pa-5 hover-lift h-100">
                <div class="d-flex align-center justify-space-between mb-4">
                    <div class="icon-box icon-box-info">
                        <MudIcon Icon="@Icons.Material.Rounded.PendingActions" Size="Size.Medium" />
                    </div>
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">
                        MassTransit
                    </MudChip>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-uppercase font-weight-bold">Async Workers</MudText>
                <MudText Typo="Typo.h4" Class="font-weight-bold my-1">Hangfire Jobs</MudText>
                <div class="d-flex align-center gap-1 mt-2">
                    <MudIcon Icon="@Icons.Material.Rounded.NotificationsActive" Color="Color.Success" Size="Size.Small" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">In-app notifications integration</MudText>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Two-Column Architecture & Tools Grid -->
    <MudGrid Spacing="4">
        <!-- Left: Architecture Highlights & Stack Features -->
        <MudItem xs="12" md="8">
            <MudCard Elevation="0" Class="rounded-2xl glass-panel pa-6 h-100">
                <div class="d-flex align-center justify-space-between mb-4">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Rounded.AccountTree" Color="Color.Primary" Size="Size.Medium" />
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Layered Architecture</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Strict unidirectional dependencies</MudText>
                        </div>
                    </div>
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                        .NET 10.0
                    </MudChip>
                </div>

                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="4">
                        <div class="pa-4 rounded-xl" style="background: rgba(var(--mud-palette-primary-rgb), 0.05); border: 1px solid var(--mud-palette-lines-default);">
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Rounded.Hub" Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary">Core Layer</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.85rem;">
                                Rich Domain Entities, MediatR CQRS handlers, Validation Behaviors, Result Pattern, and Domain Events.
                            </MudText>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <div class="pa-4 rounded-xl" style="background: rgba(var(--mud-palette-success-rgb), 0.05); border: 1px solid var(--mud-palette-lines-default);">
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Rounded.Storage" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Success">Infrastructure</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.85rem;">
                                EF Core 10 (SQL Server), ASP.NET Identity, PBAC with dynamic policies, MassTransit Event Bus, and Hangfire.
                            </MudText>
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <div class="pa-4 rounded-xl" style="background: rgba(var(--mud-palette-info-rgb), 0.05); border: 1px solid var(--mud-palette-lines-default);">
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Rounded.Web" Color="Color.Info" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Info">Presentation</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.85rem;">
                                Versioned REST WebAPI with OpenTelemetry, Scalar UI, Rate Limiting, and Interactive Blazor Server WebUI.
                            </MudText>
                        </div>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-5" />

                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">Enterprise Capabilities Built-In</MudText>
                <div class="d-flex gap-2 flex-wrap">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Fingerprint">
                        Idempotency Key
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.SyncLock">
                        Refresh Token Rotation
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Tune">
                        Dynamic App Settings
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Notifications">
                        In-App Notifications
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.History">
                        Audit Trail Table
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Shield">
                        PBAC Matrix
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Speed">
                        Polly Resilience
                    </MudChip>
                </div>
            </MudCard>
        </MudItem>

        <!-- Right: Developer Tools & Direct Links -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="0" Class="rounded-2xl glass-panel pa-6 h-100 d-flex flex-column justify-space-between">
                <div>
                    <div class="d-flex align-center gap-3 mb-4">
                        <MudIcon Icon="@Icons.Material.Rounded.RocketLaunch" Color="Color.Secondary" Size="Size.Medium" />
                        <div>
                            <MudText Typo="Typo.h6" Class="font-weight-bold">Developer Launchpad</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Quick access to runtime tools</MudText>
                        </div>
                    </div>

                    <MudList T="string" Dense="true" Class="pa-0">
                        <!-- Scalar UI -->
                        <MudListItem Class="pa-3 mb-2 rounded-xl" Style="border: 1px solid var(--mud-palette-lines-default);"
                                     OnClick='() => OpenExternalUrl($"{Configuration["ApiBaseUrl"]}/scalar/v1")'>
                            <div class="d-flex align-center justify-space-between">
                                <div class="d-flex align-center gap-3">
                                    <div class="icon-box icon-box-primary" style="width: 36px; height: 36px;">
                                        <MudIcon Icon="@Icons.Material.Rounded.Api" Size="Size.Small" />
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">Scalar OpenAPI</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Offline interactive docs</MudText>
                                    </div>
                                </div>
                                <MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" Color="Color.Secondary" />
                            </div>
                        </MudListItem>

                        <!-- Hangfire Dashboard -->
                        <MudListItem Class="pa-3 mb-2 rounded-xl" Style="border: 1px solid var(--mud-palette-lines-default);"
                                     OnClick='() => OpenExternalUrl($"{Configuration["ApiBaseUrl"]}/hangfire")'>
                            <div class="d-flex align-center justify-space-between">
                                <div class="d-flex align-center gap-3">
                                    <div class="icon-box icon-box-warning" style="width: 36px; height: 36px;">
                                        <MudIcon Icon="@Icons.Material.Rounded.Schedule" Size="Size.Small" />
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">Hangfire Dashboard</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Background jobs & recurring</MudText>
                                    </div>
                                </div>
                                <MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" Color="Color.Secondary" />
                            </div>
                        </MudListItem>

                        <!-- API Health Check -->
                        <MudListItem Class="pa-3 mb-2 rounded-xl" Style="border: 1px solid var(--mud-palette-lines-default);"
                                     OnClick='() => OpenExternalUrl($"{Configuration["ApiBaseUrl"]}/health")'>
                            <div class="d-flex align-center justify-space-between">
                                <div class="d-flex align-center gap-3">
                                    <div class="icon-box icon-box-success" style="width: 36px; height: 36px;">
                                        <MudIcon Icon="@Icons.Material.Rounded.MonitorHeart" Size="Size.Small" />
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">Health Endpoint</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Database connectivity ping</MudText>
                                    </div>
                                </div>
                                <MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" Color="Color.Secondary" />
                            </div>
                        </MudListItem>
                    </MudList>
                </div>

                <div class="pa-4 rounded-xl mt-4 text-center" style="background: rgba(var(--mud-palette-primary-rgb), 0.04); border: 1px dashed var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                        NuGet Template Package
                    </MudText>
                    <code style="font-size: 0.75rem; color: var(--mud-palette-primary); font-weight: 600;">
                        dotnet new cleanarch -n MyApp
                    </code>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>
</div>

@code {
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            _userName = authState.User.Identity.Name;
        }
    }

    private void OpenExternalUrl(string url)
    {
        NavigationManager.NavigateTo(url, forceLoad: true);
    }
}
