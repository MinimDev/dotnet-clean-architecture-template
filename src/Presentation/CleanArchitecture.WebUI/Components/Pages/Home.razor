@page "/"
@using CleanArchitecture.WebUI.Services
@using CleanArchitecture.WebUI.Services.Models
@inject TokenProvider TokenProvider
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard - Clean Architecture Template</PageTitle>

<div class="my-4">
    <!-- Hero Banner Card -->
    <MudPaper Elevation="0" Class="pa-4 pa-sm-5 rounded-2xl hero-banner position-relative overflow-hidden mb-4">
        <div class="position-absolute" style="top: -20px; right: -20px; opacity: 0.05; pointer-events: none;">
            <MudIcon Icon="@Icons.Material.Filled.Layers" Style="font-size: 140px; color: var(--mud-palette-primary);" />
        </div>

        <div class="d-flex flex-column flex-md-row justify-space-between align-start align-md-center gap-3 position-relative">
            <div>
                <div class="d-inline-flex align-center gap-2 status-pill mb-2" style="background: rgba(var(--mud-palette-primary-rgb), 0.12); color: var(--mud-palette-primary); font-size: 0.72rem;">
                    <span class="pulse-dot pulse-primary"></span>
                    <span>Clean Architecture Solution Template · v1.8.0 GA</span>
                </div>
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-1 text-gradient-primary" Style="letter-spacing: -0.01em;">
                    Welcome back, @(_userName ?? "Developer")!
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="max-width: 680px; font-size: 0.8125rem; line-height: 1.45;">
                    Enterprise solution starter implementing Clean Architecture principles with .NET 10, Blazor Server, MediatR CQRS, and Permission-Based Access Control (PBAC).
                </MudText>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Inventory2"
                           OnClick='() => NavigationManager.NavigateTo("products")' Class="rounded-lg px-3 py-1-5 hover-lift" Size="Size.Small">
                    View Products
                </MudButton>
                @if (TokenProvider.Roles.Contains("Admin"))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.AdminPanelSettings"
                               OnClick='() => NavigationManager.NavigateTo("users")' Class="rounded-lg px-3 py-1-5 hover-lift" Size="Size.Small">
                        PBAC Matrix
                    </MudButton>
                }
            </div>
        </div>
    </MudPaper>

    <!-- Key Metrics / KPI Grid -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3" Class="d-flex flex-column">
            <StatCard Title="Access Control" Value="14 Permissions" Subtitle="Dynamic policy provider"
                      Icon="@Icons.Material.Rounded.Security" IconColor="Color.Primary"
                      BadgeText="PBAC Active" BadgeColor="Color.Primary"
                      TrendText="Dynamic Policy" IsTrendPositive="true"
                      OnClick='() => NavigationManager.NavigateTo("users")' />
        </MudItem>
        <MudItem xs="12" sm="6" md="3" Class="d-flex flex-column">
            <StatCard Title="Catalog Domain" Value="CQRS Pipeline" Subtitle="Idempotency-Key guarded"
                      Icon="@Icons.Material.Rounded.Inventory2" IconColor="Color.Success"
                      BadgeText="Output Cache" BadgeColor="Color.Success"
                      TrendText="Real-time Cache" IsTrendPositive="true"
                      OnClick='() => NavigationManager.NavigateTo("products")' />
        </MudItem>
        <MudItem xs="12" sm="6" md="3" Class="d-flex flex-column">
            <StatCard Title="Data Integrity" Value="Audit Trail" Subtitle="Side-by-side JSON diffs"
                      Icon="@Icons.Material.Rounded.HistoryEdu" IconColor="Color.Warning"
                      BadgeText="100% Tracked" BadgeColor="Color.Warning"
                      TrendText="Immutable" IsTrendPositive="true"
                      OnClick='() => NavigationManager.NavigateTo("audit-logs")' />
        </MudItem>
        <MudItem xs="12" sm="6" md="3" Class="d-flex flex-column">
            <StatCard Title="Async Workers" Value="Hangfire Jobs" Subtitle="In-app notifications"
                      Icon="@Icons.Material.Rounded.PendingActions" IconColor="Color.Info"
                      BadgeText="MassTransit" BadgeColor="Color.Info"
                      TrendText="Background Bus" IsTrendPositive="true"
                      OnClick='() => NavigationManager.NavigateTo("settings")' />
        </MudItem>
    </MudGrid>

    <!-- Two-Column Architecture & Tools Grid -->
    <MudGrid Spacing="3">
        <!-- Left: Architecture Highlights & Stack Features -->
        <MudItem xs="12" md="8" Class="d-flex flex-column">
            <MudCard Elevation="0" Class="rounded-xl pa-4 pa-sm-5 h-100 flex-grow-1 d-flex flex-column justify-space-between">
                <div>
                    <div class="d-flex align-center justify-space-between mb-3">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Rounded.AccountTree" Color="Color.Primary" Size="Size.Small" />
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="font-size: 0.95rem;">Layered Architecture</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">Strict unidirectional dependencies</MudText>
                            </div>
                        </div>
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" Style="font-size: 0.7rem; height: 22px;">
                            .NET 10.0
                        </MudChip>
                    </div>

                    <MudGrid Spacing="2" Class="mt-1">
                        <MudItem xs="12" sm="4" Class="d-flex flex-column">
                            <div class="pa-3 rounded-xl feature-block flex-grow-1 h-100 d-flex flex-column">
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudIcon Icon="@Icons.Material.Rounded.Hub" Color="Color.Primary" Size="Size.Small" Style="font-size: 1rem;" />
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary" Style="font-size: 0.82rem;">Core Layer</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.78rem; line-height: 1.4;">
                                    Rich Domain Entities, MediatR CQRS handlers, Validation Behaviors, and Domain Events.
                                </MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="4" Class="d-flex flex-column">
                            <div class="pa-3 rounded-xl feature-block flex-grow-1 h-100 d-flex flex-column">
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudIcon Icon="@Icons.Material.Rounded.Storage" Color="Color.Success" Size="Size.Small" Style="font-size: 1rem;" />
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Success" Style="font-size: 0.82rem;">Infrastructure</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.78rem; line-height: 1.4;">
                                    EF Core 10, ASP.NET Identity, PBAC matrix policies, MassTransit Bus, and Hangfire.
                                </MudText>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="4" Class="d-flex flex-column">
                            <div class="pa-3 rounded-xl feature-block flex-grow-1 h-100 d-flex flex-column">
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudIcon Icon="@Icons.Material.Rounded.Web" Color="Color.Info" Size="Size.Small" Style="font-size: 1rem;" />
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Info" Style="font-size: 0.82rem;">Presentation</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.78rem; line-height: 1.4;">
                                    Versioned REST WebAPI with OpenTelemetry, Scalar UI, Rate Limiting, and Blazor WebUI.
                                </MudText>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2" Style="font-size: 0.82rem;">Enterprise Capabilities Built-In</MudText>
                    <div class="d-flex gap-1-5 flex-wrap">
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Fingerprint" Style="font-size: 0.72rem; height: 24px;">
                            Idempotency Key
                        </MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.SyncLock" Style="font-size: 0.72rem; height: 24px;">
                            Refresh Token Rotation
                        </MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Tune" Style="font-size: 0.72rem; height: 24px;">
                            Dynamic App Settings
                        </MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Notifications" Style="font-size: 0.72rem; height: 24px;">
                            In-App Notifications
                        </MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.History" Style="font-size: 0.72rem; height: 24px;">
                            Audit Trail Table
                        </MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Shield" Style="font-size: 0.72rem; height: 24px;">
                            PBAC Matrix
                        </MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Rounded.Speed" Style="font-size: 0.72rem; height: 24px;">
                            Polly Resilience
                        </MudChip>
                    </div>
                </div>
            </MudCard>
        </MudItem>

        <!-- Right: Developer Tools & Direct Links -->
        <MudItem xs="12" md="4" Class="d-flex flex-column">
            <MudCard Elevation="0" Class="rounded-xl pa-4 pa-sm-5 h-100 flex-grow-1 d-flex flex-column justify-space-between">
                <div>
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudIcon Icon="@Icons.Material.Rounded.RocketLaunch" Color="Color.Secondary" Size="Size.Small" />
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="font-size: 0.95rem;">Developer Launchpad</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem;">Quick access to runtime tools</MudText>
                        </div>
                    </div>

                    <MudList T="string" Dense="true" Class="pa-0">
                        <!-- Scalar UI -->
                        <MudListItem Class="pa-3 mb-2 rounded-xl" Style="border: 1px solid var(--mud-palette-lines-default);"
                                     OnClick='() => OpenExternalUrl($"{Configuration["ApiBaseUrl"]}/scalar/v1")'>
                            <div class="d-flex align-center justify-space-between">
                                <div class="d-flex align-center gap-3">
                                    <div class="icon-box icon-box-primary" style="width: 36px; height: 36px;">
                                        <MudIcon Icon="@Icons.Material.Rounded.Api" Size="Size.Small" />
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">Scalar OpenAPI</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Offline interactive docs</MudText>
                                    </div>
                                </div>
                                <MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" Color="Color.Secondary" />
                            </div>
                        </MudListItem>

                        <!-- Hangfire Dashboard -->
                        <MudListItem Class="pa-3 mb-2 rounded-xl" Style="border: 1px solid var(--mud-palette-lines-default);"
                                     OnClick='() => OpenExternalUrl($"{Configuration["ApiBaseUrl"]}/hangfire")'>
                            <div class="d-flex align-center justify-space-between">
                                <div class="d-flex align-center gap-3">
                                    <div class="icon-box icon-box-warning" style="width: 36px; height: 36px;">
                                        <MudIcon Icon="@Icons.Material.Rounded.Schedule" Size="Size.Small" />
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">Hangfire Dashboard</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Background jobs & recurring</MudText>
                                    </div>
                                </div>
                                <MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" Color="Color.Secondary" />
                            </div>
                        </MudListItem>

                        <!-- API Health Check -->
                        <MudListItem Class="pa-3 mb-2 rounded-xl" Style="border: 1px solid var(--mud-palette-lines-default);"
                                     OnClick='() => OpenExternalUrl($"{Configuration["ApiBaseUrl"]}/health")'>
                            <div class="d-flex align-center justify-space-between">
                                <div class="d-flex align-center gap-3">
                                    <div class="icon-box icon-box-success" style="width: 36px; height: 36px;">
                                        <MudIcon Icon="@Icons.Material.Rounded.MonitorHeart" Size="Size.Small" />
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">Health Endpoint</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Database connectivity ping</MudText>
                                    </div>
                                </div>
                                <MudIcon Icon="@Icons.Material.Rounded.OpenInNew" Size="Size.Small" Color="Color.Secondary" />
                            </div>
                        </MudListItem>
                    </MudList>
                </div>

                <div class="pa-4 rounded-xl mt-4 text-center" style="background: rgba(var(--mud-palette-primary-rgb), 0.04); border: 1px dashed var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                        NuGet Template Package
                    </MudText>
                    <code style="font-size: 0.75rem; color: var(--mud-palette-primary); font-weight: 600;">
                        dotnet new cleanarch -n MyApp
                    </code>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>
</div>

@code {
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            _userName = authState.User.Identity.Name;
        }
    }

    private void OpenExternalUrl(string url)
    {
        NavigationManager.NavigateTo(url, forceLoad: true);
    }
}
