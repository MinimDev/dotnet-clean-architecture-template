@page "/products"
@using CleanArchitecture.WebUI.Services
@using CleanArchitecture.WebUI.Services.Models
@inject ProductsClient Client
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TokenProvider TokenProvider

<AuthorizeView>
    <Authorized>
        <div class="products-page">
            <!-- Header Section using PageHeader Shared Component -->
            <PageHeader Title="Products"
                        Subtitle="Browse, search, and manage product catalog inventory"
                        Icon="@Icons.Material.Rounded.Inventory2"
                        BadgeText="@($"{_totalItems} Items")">
                <Actions>
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudTextField T="string" Value="@_searchString" ValueChanged="@OnSearchChanged"
                                      Placeholder="Search products..." Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      Class="rounded-lg bg-surface" Style="min-width: 200px; max-width: 280px; font-size: 0.85rem;" />

                        <!-- View Switcher: Grid vs Table -->
                        <div class="d-flex align-center border-solid border-1 rounded-lg overflow-hidden" style="border-color: var(--mud-palette-lines-default); background: var(--mud-palette-surface);">
                            <MudTooltip Text="Grid View">
                                <MudIconButton Icon="@Icons.Material.Rounded.GridView"
                                               Size="Size.Small"
                                               Color="@(!_isTableView ? Color.Primary : Color.Default)"
                                               OnClick="@(() => _isTableView = false)"
                                               Style="@(!_isTableView ? "background: rgba(var(--mud-palette-primary-rgb), 0.12);" : "")" />
                            </MudTooltip>
                            <MudTooltip Text="Table View">
                                <MudIconButton Icon="@Icons.Material.Rounded.ViewList"
                                               Size="Size.Small"
                                               Color="@(_isTableView ? Color.Primary : Color.Default)"
                                               OnClick="@(() => _isTableView = true)"
                                               Style="@(_isTableView ? "background: rgba(var(--mud-palette-primary-rgb), 0.12);" : "")" />
                            </MudTooltip>
                        </div>

                        @if (TokenProvider.HasPermission(Permissions.Products.Create))
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="CreateProduct" Size="Size.Small" Class="rounded-lg text-nowrap hover-lift px-3 py-1-5">
                                New Product
                            </MudButton>
                        }
                    </div>
                </Actions>
            </PageHeader>

            <!-- Loading State -->
            @if (_isLoading)
            {
                @if (_isTableView)
                {
                    <TableSkeleton Rows="8" Columns="6" />
                }
                else
                {
                    <MudGrid Spacing="3">
                        @for (int i = 0; i < 8; i++)
                        {
                            <MudItem xs="12" sm="6" md="4" lg="3">
                                <MudCard Elevation="0" Class="rounded-xl overflow-hidden product-card border-solid border-1" Style="border-color: var(--mud-palette-lines-default);">
                                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Animation="Animation.Wave" />
                                    <MudCardContent Class="pa-3">
                                        <MudSkeleton Width="75%" Height="24px" Class="mb-2" Animation="Animation.Wave" />
                                        <MudSkeleton Width="40%" Height="20px" Class="mb-3" Animation="Animation.Wave" />
                                        <MudSkeleton Width="100%" Height="14px" Animation="Animation.Wave" />
                                    </MudCardContent>
                                    <MudCardActions Class="pa-3 pt-0">
                                        <MudSkeleton Width="48px" Height="28px" Class="ml-auto" Animation="Animation.Wave" />
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
            }
            else if (_products == null || !_products.Any())
            {
                <!-- Empty State using Shared Component -->
                <EmptyState Title="No Products Found"
                            Description="You haven't added any products or none match your search criteria. Create your first product to get started!"
                            Icon="@Icons.Material.Rounded.Inventory2"
                            ActionText="@(TokenProvider.HasPermission(Permissions.Products.Create) ? "Create Your First Product" : null)"
                            ActionIcon="@Icons.Material.Rounded.Add"
                            OnActionClick="CreateProduct" />
            }
            else
            {
                <!-- DATA TABLE VIEW -->
                @if (_isTableView)
                {
                    <MudTable Items="@_products" Elevation="0" Class="rounded-xl border-solid border-1 overflow-hidden"
                              Style="border-color: var(--mud-palette-lines-default); background: var(--mud-palette-surface);"
                              Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Product</MudTh>
                            <MudTh>Price</MudTh>
                            <MudTh>Stock</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Created</MudTh>
                            <MudTh Style="text-align: right;">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="product">
                            <MudTd DataLabel="Product">
                                <div class="d-flex align-center gap-2">
                                    <div class="product-mini-box flex-shrink-0" style="background: rgba(var(--mud-palette-primary-rgb), 0.1);">
                                        <MudIcon Icon="@Icons.Material.Rounded.Inventory2" Size="Size.Small" Color="Color.Primary" />
                                    </div>
                                    <div>
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">@product.Name</MudText>
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate d-block" Style="max-width: 260px;">
                                                @product.Description
                                            </MudText>
                                        }
                                    </div>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="Price">
                                <span class="font-weight-bold" style="color: var(--mud-palette-primary);">
                                    @(product.Price > 0 ? product.PriceDisplay : "Free")
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Stock">
                                <span class="product-stock-tag @(product.Stock > 0 ? "stock-in" : "stock-out")">
                                    @product.Stock units
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                @if (product.Status == "Active")
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="font-weight-bold" Style="font-size: 0.68rem; height: 22px;">
                                        Active
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="font-weight-bold" Style="font-size: 0.68rem; height: 22px;">
                                        @product.Status
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Created">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @product.CreatedAt.ToString("MMM dd, yyyy")
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Actions" Style="text-align: right;">
                                <div class="d-inline-flex align-center gap-1">
                                    <MudTooltip Text="View Details">
                                        <MudIconButton Icon="@Icons.Material.Rounded.Visibility" Size="Size.Small" Class="action-icon-btn action-view" OnClick="@(() => ViewProductDetail(product))" />
                                    </MudTooltip>
                                    @if (TokenProvider.HasPermission(Permissions.Products.Edit))
                                    {
                                        <MudTooltip Text="Edit Product">
                                            <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" Class="action-icon-btn action-edit" OnClick="@(() => EditProduct(product))" />
                                        </MudTooltip>
                                    }
                                    @if (TokenProvider.HasPermission(Permissions.Products.Delete))
                                    {
                                        <MudTooltip Text="Delete Product">
                                            <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Class="action-icon-btn action-delete" OnClick="@(() => DeleteProduct(product))" />
                                        </MudTooltip>
                                    }
                                </div>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <!-- GRID CARD VIEW -->
                    <MudGrid Spacing="3">
                        @foreach (var product in _products)
                        {
                            var currentTheme = GetCardTheme(product.Id.ToString());
                            <MudItem xs="12" sm="6" md="4" lg="3" Class="d-flex flex-column">
                                <MudCard Elevation="0" Class="rounded-xl product-card flex-column d-flex h-100 flex-grow-1 border-solid border-1" Style="border-color: var(--mud-palette-lines-default);">
                                    <!-- Elegant SaaS Visual Banner (84px) -->
                                    <div class="product-card-banner" style="background: @currentTheme.gradient;">
                                        <div class="card-icon-glass">
                                            <MudIcon Icon="@Icons.Material.Rounded.Inventory2" Size="Size.Medium" Style="color: white; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));" />
                                        </div>
                                        @if (product.Status == "Active")
                                        {
                                            <span class="product-status-pill status-active">
                                                <span class="status-dot-active"></span> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="product-status-pill status-inactive">
                                                <span class="status-dot-inactive"></span> @(product.Status)
                                            </span>
                                        }
                                    </div>

                                    <MudCardContent Class="flex-grow-1 pa-3 pt-3 pb-2 d-flex flex-column">
                                        <div class="product-card-title mb-1" title="@product.Name">
                                            @product.Name
                                        </div>

                                        <div class="d-flex align-center justify-space-between mb-2">
                                            <span class="product-card-price">@(product.Price > 0 ? product.PriceDisplay : "Free")</span>
                                            <span class="product-stock-tag @(product.Stock > 0 ? "stock-in" : "stock-out")">
                                                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Style="font-size: 0.72rem;" />
                                                <span>@product.Stock stock</span>
                                            </span>
                                        </div>

                                        <div class="product-card-footer d-flex align-center justify-space-between mt-auto pt-2 border-t border-solid" style="border-color: var(--mud-palette-lines-default) !important;">
                                            <span class="product-card-date d-flex align-center gap-1">
                                                <MudIcon Icon="@Icons.Material.Outlined.Event" Style="font-size: 0.72rem;" Color="Color.Secondary" />
                                                <span>@product.CreatedAt.ToString("MMM dd")</span>
                                            </span>

                                            <div class="d-flex align-center gap-1">
                                                <MudTooltip Text="View Details">
                                                    <MudIconButton Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" Class="action-icon-btn action-view" OnClick="@(() => ViewProductDetail(product))" />
                                                </MudTooltip>
                                                @if (TokenProvider.HasPermission(Permissions.Products.Edit))
                                                {
                                                    <MudTooltip Text="Edit Product">
                                                        <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" Class="action-icon-btn action-edit" OnClick="@(() => EditProduct(product))" />
                                                    </MudTooltip>
                                                }
                                                @if (TokenProvider.HasPermission(Permissions.Products.Delete))
                                                {
                                                    <MudTooltip Text="Delete Product">
                                                        <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" Class="action-icon-btn action-delete" OnClick="@(() => DeleteProduct(product))" />
                                                    </MudTooltip>
                                                }
                                            </div>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }

                <!-- Pagination -->
                <div class="d-flex justify-center mt-6 mb-2">
                    <MudPagination Color="Color.Primary" Count="@_totalPages" Selected="@_currentPage" SelectedChanged="OnPageChanged"
                                   ShowFirstButton="true" ShowLastButton="true" Variant="Variant.Filled" Class="rounded-xl shadow-sm" Size="Size.Small"/>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-12 text-center">
            <MudPaper Class="pa-8 rounded-2xl" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Warning" Class="mb-3" />
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">Sign In Required</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Please sign in to your account to view and manage the product catalog.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" Class="rounded-lg px-6">
                    Sign In
                </MudButton>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

<style>
    .product-mini-box {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    private List<ProductDto> _products = new();
    private bool _isLoading = true;
    private string _searchString = "";
    private bool _isTableView = false;

    // Pagination state
    private int _currentPage = 1;
    private int _pageSize = 8;
    private int _totalPages = 1;
    private int _totalItems = 0;

    private static readonly (string gradient, string iconColor)[] CardPalettes = new[]
    {
        ("linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%)", "#ffffff"),  // Indigo
        ("linear-gradient(135deg, #0284c7 0%, #0369a1 100%)", "#ffffff"),  // Sky
        ("linear-gradient(135deg, #059669 0%, #047857 100%)", "#ffffff"),  // Emerald
        ("linear-gradient(135deg, #d97706 0%, #b45309 100%)", "#ffffff"),  // Amber
        ("linear-gradient(135deg, #db2777 0%, #9333ea 100%)", "#ffffff"),  // Rose/Violet
        ("linear-gradient(135deg, #475569 0%, #334155 100%)", "#ffffff")   // Slate
    };

    private (string gradient, string iconColor) GetCardTheme(string id)
    {
        uint hash = (uint)(id?.GetHashCode() ?? 0);
        return CardPalettes[hash % (uint)CardPalettes.Length];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadProducts();
        }
    }

    private async Task OnSearchChanged(string text)
    {
        _searchString = text;
        _currentPage = 1;
        await LoadProducts();
    }

    private async Task OnPageChanged(int i)
    {
        _currentPage = i;
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        _isLoading = true;
        StateHasChanged();

        var result = await Client.GetProductsAsync(_currentPage, _pageSize, _searchString);

        if (result.IsSuccess && result.Data != null)
        {
            _products = result.Data.Items;
            _totalItems = result.Data.TotalCount;
            _totalPages = result.Data.TotalPages > 0 ? result.Data.TotalPages : 1;
        }
        else
        {
            _products = new List<ProductDto>();
            _totalPages = 1;
            _totalItems = 0;
            if (!string.IsNullOrEmpty(result.Error))
            {
                Snackbar.Add($"Failed to load products: {result.Error}", Severity.Error);
            }
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task CreateProduct()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateProductDialog>("New Product", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            _currentPage = 1;
            await LoadProducts();
        }
    }

    private async Task EditProduct(ProductDto product)
    {
        var parameters = new DialogParameters { ["Product"] = product };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditProductDialog>("Edit Product", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadProducts();
        }
    }

    private async Task DeleteProduct(ProductDto product)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.Title, "Delete Product" },
            { x => x.Message, "Are you sure you want to permanently delete this product? All linked records will be affected." },
            { x => x.ItemName, product.Name },
            { x => x.ConfirmText, "Delete Product" },
            { x => x.ConfirmColor, Color.Error }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Delete Product", parameters, options);
        var dialogResult = await dialog.Result;

        if (dialogResult is not null && !dialogResult.Canceled)
        {
            var result = await Client.DeleteProductAsync(product.Id);
            if (result.IsSuccess)
            {
                Snackbar.Add("Product deleted successfully", Severity.Success);
                if (_products.Count == 1 && _currentPage > 1)
                    _currentPage--;
                await LoadProducts();
            }
            else
            {
                Snackbar.Add($"Failed to delete product: {result.Error}", Severity.Error);
            }
        }
    }

    private async Task ViewProductDetail(ProductDto product)
    {
        var parameters = new DialogParameters { ["Product"] = product };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<ProductDetailDialog>($"Product Details - {product.Name}", parameters, options);
    }
}
