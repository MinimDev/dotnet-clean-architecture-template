@page "/settings"
@using CleanArchitecture.WebUI.Services
@using CleanArchitecture.WebUI.Services.Models
@inject AppSettingsClient Client
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject TokenProvider TokenProvider

<AuthorizeView>
    <Authorized>
        @if (TokenProvider.HasPermission(Permissions.AppSettings.View))
        {
            <div class="settings-page">
                <!-- PageHeader Shared Component -->
                <PageHeader Title="App Settings & Feature Flags"
                            Subtitle="Manage dynamic configuration, feature toggles, and runtime parameters"
                            Icon="@Icons.Material.Rounded.Tune"
                            BadgeText="@($"{_allSettings.Count} Keys")">
                    <Actions>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="LoadSettingsAsync" Class="rounded-lg" Size="Size.Small" Disabled="@_isLoading">
                            Refresh
                        </MudButton>
                    </Actions>
                </PageHeader>

                <!-- Filter & Search Controls Panel -->
                <MudCard Elevation="0" Class="rounded-2xl mb-4 filter-card border-solid border-1"
                         Style="border-color: var(--mud-palette-lines-default); background: var(--mud-palette-surface);">
                    <MudCardContent Class="pa-3-5">
                        <MudGrid Spacing="3" Class="align-center">
                            <!-- Group Category Filter Chips -->
                            <MudItem xs="12" md="7">
                                <MudText Typo="Typo.caption" Class="font-weight-bold text-uppercase mb-1 d-block" Color="Color.Secondary" Style="font-size: 0.7rem; letter-spacing: 0.05em;">
                                    Group Category
                                </MudText>
                                <div class="d-flex gap-1 flex-wrap">
                                    <MudChip T="string" Color="@(string.IsNullOrEmpty(_selectedGroup) ? Color.Primary : Color.Default)"
                                             Variant="@(string.IsNullOrEmpty(_selectedGroup) ? Variant.Filled : Variant.Outlined)"
                                             Size="Size.Small" OnClick="@(() => FilterByGroup(null))" Class="cursor-pointer font-weight-bold" Style="font-size: 0.72rem; height: 24px;">
                                        ALL (@_allSettings.Count)
                                    </MudChip>
                                    @foreach (var group in _availableGroups)
                                    {
                                        var count = _allSettings.Count(s => s.Group.Equals(group, StringComparison.OrdinalIgnoreCase));
                                        <MudChip T="string" Color="@GetGroupColor(group)"
                                                 Variant="@(_selectedGroup == group ? Variant.Filled : Variant.Outlined)"
                                                 Size="Size.Small" OnClick="@(() => FilterByGroup(group))" Class="cursor-pointer font-weight-bold" Style="font-size: 0.72rem; height: 24px;">
                                            @group.ToUpperInvariant() (@count)
                                        </MudChip>
                                    }
                                </div>
                            </MudItem>

                            <!-- Search Filter -->
                            <MudItem xs="12" md="5">
                                <MudTextField T="string" Value="@_searchQuery" ValueChanged="OnSearchChanged"
                                              Placeholder="Search settings by key or description..."
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                              IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Immediate="true" Clearable="true" Class="rounded-lg bg-surface" Style="font-size: 0.85rem;" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                <!-- Settings Content -->
                @if (_isLoading)
                {
                    <MudGrid Spacing="3">
                        @for (int i = 0; i < 4; i++)
                        {
                            <MudItem xs="12" md="6">
                                <MudCard Elevation="0" Class="rounded-2xl pa-4 mb-3 border-solid border-1" Style="border-color: var(--mud-palette-lines-default);">
                                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="28px" Width="50%" Class="mb-2 rounded" Animation="Animation.Wave" />
                                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Class="mb-3" Animation="Animation.Wave" />
                                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="38px" Class="rounded-lg" Animation="Animation.Wave" />
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else if (!FilteredSettings.Any())
                {
                    <EmptyState Title="No Configuration Settings Found"
                                Description="No settings match your current search query or group filter. Try clearing filters to see all available configuration keys."
                                Icon="@Icons.Material.Rounded.SearchOff"
                                ActionText="@((!string.IsNullOrEmpty(_searchQuery) || !string.IsNullOrEmpty(_selectedGroup)) ? "Reset Filters" : "Refresh")"
                                ActionIcon="@((!string.IsNullOrEmpty(_searchQuery) || !string.IsNullOrEmpty(_selectedGroup)) ? Icons.Material.Filled.FilterAltOff : Icons.Material.Filled.Refresh)"
                                OnActionClick="OnEmptyActionClick" />
                }
                else
                {
                    <!-- Settings Grid by Group -->
                    @foreach (var group in FilteredSettings.GroupBy(s => s.Group).OrderBy(g => g.Key))
                    {
                        <div class="mb-6">
                            <!-- Group Header -->
                            <div class="d-flex align-center gap-2 mb-3">
                                <MudIcon Icon="@GetGroupIcon(group.Key)" Color="@GetGroupColor(group.Key)" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@group.Key</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetGroupColor(group.Key)" Class="font-weight-bold" Style="font-size: 0.68rem; height: 20px;">
                                    @group.Count() settings
                                </MudChip>
                            </div>

                            <MudGrid Spacing="3">
                                @foreach (var setting in group.OrderBy(s => s.Key))
                                {
                                    <MudItem xs="12" md="6" lg="6">
                                        <MudCard Elevation="0" Class="@($"rounded-2xl h-100 setting-card border-solid border-1 {(setting.IsReadOnly ? "setting-card-readonly" : "")}")"
                                                 Style="border-color: var(--mud-palette-lines-default); background: var(--mud-palette-surface);">
                                            <MudCardHeader Class="pb-1">
                                                <CardHeaderContent>
                                                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                                        <div class="d-flex align-center gap-2">
                                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold font-monospace setting-key">
                                                                @setting.Key
                                                            </MudText>
                                                        </div>
                                                        <div class="d-flex align-center gap-1">
                                                            @if (setting.IsReadOnly)
                                                            {
                                                                <MudTooltip Text="Read-only setting. Value cannot be modified via UI.">
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled"
                                                                             Icon="@Icons.Material.Filled.Lock" Class="font-weight-bold" Style="font-size: 0.65rem; height: 20px;">
                                                                        READ-ONLY
                                                                    </MudChip>
                                                                </MudTooltip>
                                                            }
                                                            <MudChip T="string" Size="Size.Small" Color="@GetDataTypeColor(setting.DataType)"
                                                                     Variant="Variant.Outlined" Class="font-weight-bold text-uppercase" Style="font-size: 0.65rem; height: 20px;">
                                                                @setting.DataType
                                                            </MudChip>
                                                        </div>
                                                    </div>
                                                </CardHeaderContent>
                                            </MudCardHeader>

                                            <MudCardContent Class="pt-1 pb-3">
                                                <!-- Description -->
                                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3 setting-desc" Style="font-size: 0.8125rem;">
                                                    @(string.IsNullOrWhiteSpace(setting.Description) ? "No description provided." : setting.Description)
                                                </MudText>

                                                <!-- Dynamic Editor based on DataType -->
                                                <div class="setting-editor-box pa-2-5 rounded-xl border-solid border-1"
                                                     style="background: var(--mud-palette-background-grey); border-color: var(--mud-palette-lines-default);">
                                                    @if (setting.DataType.Equals("boolean", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        var isChecked = bool.TryParse(GetEditValue(setting), out var b) && b;
                                                        <div class="d-flex align-center justify-space-between">
                                                            <div class="d-flex align-center gap-2">
                                                                <MudIcon Icon="@(isChecked ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                                                         Color="@(isChecked ? Color.Success : Color.Default)" Size="Size.Small" />
                                                                <MudText Typo="Typo.body2" Class="font-weight-bold" Color="@(isChecked ? Color.Success : Color.Secondary)">
                                                                    @(isChecked ? "ENABLED" : "DISABLED")
                                                                </MudText>
                                                            </div>

                                                            <MudSwitch T="bool" Value="@isChecked"
                                                                       ValueChanged="@CreateToggleCallback(setting)"
                                                                       Color="Color.Success" Disabled="@(setting.IsReadOnly || _isSavingKey == setting.Key)" />
                                                        </div>
                                                    }
                                                    else if (setting.DataType.Equals("number", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <div class="d-flex align-center gap-2">
                                                            <MudTextField T="string" Value="@GetEditValue(setting)"
                                                                          ValueChanged="@CreateInputCallback(setting)"
                                                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                          Disabled="@(setting.IsReadOnly || _isSavingKey == setting.Key)"
                                                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Numbers"
                                                                          Class="bg-surface rounded-lg" Style="font-size: 0.85rem;" />

                                                            @if (!setting.IsReadOnly)
                                                            {
                                                                <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary"
                                                                               Variant="Variant.Filled" Size="Size.Small" Class="rounded-lg hover-lift"
                                                                               Disabled="@(!IsDirty(setting) || _isSavingKey == setting.Key)"
                                                                               OnClick="@(() => SaveSettingAsync(setting))" />
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-center gap-2">
                                                            <MudTextField T="string" Value="@GetEditValue(setting)"
                                                                          ValueChanged="@CreateInputCallback(setting)"
                                                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                          Disabled="@(setting.IsReadOnly || _isSavingKey == setting.Key)"
                                                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.EditNote"
                                                                          Class="bg-surface rounded-lg" Style="font-size: 0.85rem;" />

                                                            @if (!setting.IsReadOnly)
                                                            {
                                                                <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary"
                                                                               Variant="Variant.Filled" Size="Size.Small" Class="rounded-lg hover-lift"
                                                                               Disabled="@(!IsDirty(setting) || _isSavingKey == setting.Key)"
                                                                               OnClick="@(() => SaveSettingAsync(setting))" />
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Metadata Footer -->
                                                <div class="d-flex align-center justify-space-between mt-3 text-secondary" style="font-size: 0.72rem;">
                                                    <span>
                                                        @if (setting.ModifiedAt.HasValue)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Update" Size="Size.Small" Class="mr-1" Style="vertical-align: middle; font-size: 0.75rem;" />
                                                            <span>Updated: @setting.ModifiedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                                            @if (!string.IsNullOrEmpty(setting.ModifiedBy))
                                                            {
                                                                <span> by <strong>@setting.ModifiedBy</strong></span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span>Default initial seed</span>
                                                        }
                                                    </span>

                                                    @if (IsDirty(setting) && !setting.DataType.Equals("boolean", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="text-warning font-weight-bold">Unsaved changes</span>
                                                    }
                                                </div>
                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>
                                }
                            </MudGrid>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <MudContainer MaxWidth="MaxWidth.Small" Class="pa-8 text-center">
                <MudPaper Class="pa-8 rounded-2xl" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Warning" Class="mb-3" />
                    <MudText Typo="Typo.h5" Color="Color.Warning" Class="font-weight-bold mb-2">Permission Required</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        You require 'Permissions.AppSettings.View' permission to view or manage application settings.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="rounded-lg px-6">
                        Return to Dashboard
                    </MudButton>
                </MudPaper>
            </MudContainer>
        }
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-8 text-center">
            <MudPaper Class="pa-8 rounded-2xl" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Error" Class="mb-3" />
                <MudText Typo="Typo.h5" Color="Color.Error" Class="font-weight-bold mb-2">Sign In Required</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Please sign in to access application configuration and feature flags.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" Class="rounded-lg px-6">
                    Sign In
                </MudButton>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

<style>
    .setting-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .setting-card:hover {
        transform: translateY(-2px);
    }
    .setting-card-readonly {
        opacity: 0.88;
    }
</style>

@code {
    private List<AppSettingDto> _allSettings = new();
    private List<string> _availableGroups = new();
    private Dictionary<string, string> _editValues = new();
    private string? _selectedGroup;
    private string _searchQuery = string.Empty;
    private bool _isLoading = true;
    private string? _isSavingKey;

    private IEnumerable<AppSettingDto> FilteredSettings
    {
        get
        {
            var result = _allSettings.AsEnumerable();

            if (!string.IsNullOrEmpty(_selectedGroup))
            {
                result = result.Where(s => s.Group.Equals(_selectedGroup, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLowerInvariant();
                result = result.Where(s =>
                    s.Key.ToLowerInvariant().Contains(q) ||
                    (s.Description?.ToLowerInvariant().Contains(q) ?? false) ||
                    s.Value.ToLowerInvariant().Contains(q));
            }

            return result;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSettingsAsync();
        }
    }

    private async Task LoadSettingsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var result = await Client.GetAppSettingsAsync();
            if (result.IsSuccess && result.Data != null)
            {
                _allSettings = result.Data.ToList();
                _availableGroups = _allSettings
                    .Select(s => s.Group)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(g => g)
                    .ToList();

                _editValues = _allSettings.ToDictionary(s => s.Key, s => s.Value);
            }
            else
            {
                Snackbar.Add(result.Error ?? "Failed to load application settings", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterByGroup(string? group)
    {
        _selectedGroup = group;
    }

    private void OnSearchChanged(string text)
    {
        _searchQuery = text;
    }

    private void ResetFilters()
    {
        _selectedGroup = null;
        _searchQuery = string.Empty;
    }

    private async Task OnEmptyActionClick()
    {
        if (!string.IsNullOrEmpty(_searchQuery) || !string.IsNullOrEmpty(_selectedGroup))
        {
            ResetFilters();
        }
        else
        {
            await LoadSettingsAsync();
        }
    }

    private string GetEditValue(AppSettingDto setting)
    {
        return _editValues.TryGetValue(setting.Key, out var val) ? val : setting.Value;
    }

    private void SetEditValue(string key, string value)
    {
        _editValues[key] = value;
    }

    private bool IsDirty(AppSettingDto setting)
    {
        return _editValues.TryGetValue(setting.Key, out var currentVal) &&
               !string.Equals(currentVal, setting.Value, StringComparison.Ordinal);
    }

    private async Task ToggleBooleanSetting(AppSettingDto setting, bool newValue)
    {
        if (setting.IsReadOnly)
        {
            Snackbar.Add("This setting is read-only and cannot be changed.", Severity.Warning);
            return;
        }

        var stringValue = newValue.ToString().ToLowerInvariant();
        _editValues[setting.Key] = stringValue;
        _isSavingKey = setting.Key;
        StateHasChanged();

        try
        {
            var result = await Client.UpdateAppSettingAsync(setting.Key, stringValue);
            if (result.IsSuccess)
            {
                setting.Value = stringValue;
                setting.ModifiedAt = DateTime.UtcNow;
                Snackbar.Add($"Feature '{setting.Key}' {(newValue ? "enabled" : "disabled")} successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Error ?? "Failed to update setting", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingKey = null;
            StateHasChanged();
        }
    }

    private async Task SaveSettingAsync(AppSettingDto setting)
    {
        if (setting.IsReadOnly)
        {
            Snackbar.Add("This setting is read-only and cannot be changed.", Severity.Warning);
            return;
        }

        if (!_editValues.TryGetValue(setting.Key, out var valueToSave))
        {
            return;
        }

        _isSavingKey = setting.Key;
        try
        {
            var result = await Client.UpdateAppSettingAsync(setting.Key, valueToSave);
            if (result.IsSuccess)
            {
                setting.Value = valueToSave;
                setting.ModifiedAt = DateTime.UtcNow;
                Snackbar.Add($"Setting '{setting.Key}' updated successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Error ?? "Failed to update setting", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingKey = null;
        }
    }

    private Color GetGroupColor(string group)
    {
        return group.ToLowerInvariant() switch
        {
            "general" => Color.Info,
            "features" => Color.Success,
            "security" => Color.Warning,
            "system" => Color.Secondary,
            _ => Color.Primary
        };
    }

    private string GetGroupIcon(string group)
    {
        return group.ToLowerInvariant() switch
        {
            "general" => Icons.Material.Filled.Info,
            "features" => Icons.Material.Filled.ToggleOn,
            "security" => Icons.Material.Filled.Security,
            "system" => Icons.Material.Filled.Dns,
            _ => Icons.Material.Filled.Folder
        };
    }

    private Color GetDataTypeColor(string dataType)
    {
        return dataType.ToLowerInvariant() switch
        {
            "boolean" => Color.Success,
            "number" => Color.Info,
            "string" => Color.Primary,
            _ => Color.Default
        };
    }

    private EventCallback<bool> CreateToggleCallback(AppSettingDto setting)
    {
        return EventCallback.Factory.Create<bool>(this, (bool val) => ToggleBooleanSetting(setting, val));
    }

    private EventCallback<string> CreateInputCallback(AppSettingDto setting)
    {
        return EventCallback.Factory.Create<string>(this, (string val) => SetEditValue(setting.Key, val));
    }
}
