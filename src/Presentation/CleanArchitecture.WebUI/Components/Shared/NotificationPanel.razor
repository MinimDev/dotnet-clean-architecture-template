@implements IDisposable
@using CleanArchitecture.WebUI.Services
@using CleanArchitecture.WebUI.Services.Models
@inject NotificationStateService State
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<div class="notification-dropdown-panel">
    <!-- Panel Header -->
    <div class="d-flex align-center justify-space-between pa-3 border-b border-solid" style="border-color: var(--mud-palette-lines-default) !important;">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Notifications</MudText>
            @if (State.UnreadCount > 0)
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold px-2 py-0" Style="height: 20px;">
                    @State.UnreadCount new
                </MudChip>
            }
        </div>
        <div class="d-flex align-center gap-1">
            @if (State.UnreadCount > 0)
            {
                <MudTooltip Text="Mark all as read">
                    <MudButton StartIcon="@Icons.Material.Filled.DoneAll"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Variant="Variant.Text"
                               OnClick="MarkAllAsReadAsync"
                               Disabled="@State.IsLoading"
                               Class="text-transform-none px-2"
                               Style="font-size: 0.75rem;">
                        Mark all read
                    </MudButton>
                </MudTooltip>
            }
            <MudTooltip Text="Refresh">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Size="Size.Small"
                               Color="Color.Default"
                               OnClick="() => State.LoadNotificationsAsync()"
                               Disabled="@State.IsLoading" />
            </MudTooltip>
        </div>
    </div>

    <!-- Panel Body -->
    <div class="notification-list-container" style="max-height: 420px; overflow-y: auto;">
        @if (State.IsLoading && State.Notifications.Count == 0)
        {
            <div class="pa-4">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex gap-3 mb-3">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="36px" Height="36px" />
                        <div style="flex: 1;">
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="90%" />
                            <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" />
                        </div>
                    </div>
                }
            </div>
        }
        else if (State.Notifications.Count == 0)
        {
            <div class="pa-6 text-center d-flex flex-column align-center justify-center">
                <div class="empty-icon-box mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsNone" Size="Size.Large" Color="Color.Secondary" />
                </div>
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary">You're all caught up! 🎉</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">No notifications at the moment.</MudText>
            </div>
        }
        else
        {
            <div class="notification-items-wrapper">
                @foreach (var item in State.Notifications)
                {
                    <div class="@($"notification-item pa-3 border-b border-solid {(!item.IsRead ? "notification-unread" : "")}")"
                         @onclick="@(() => OnItemClick(item))"
                         style="border-color: var(--mud-palette-lines-default) !important;">
                        <div class="d-flex align-start gap-3 w-100">
                            <!-- Type Icon Box -->
                            <div class="notification-icon-wrapper" style="@GetIconWrapperStyle(item.Type)">
                                <MudIcon Icon="@GetTypeIcon(item.Type)" Color="@GetTypeColor(item.Type)" Size="Size.Small" />
                            </div>

                            <!-- Content -->
                            <div style="flex: 1; min-width: 0;">
                                <div class="d-flex align-center justify-space-between gap-1 mb-1">
                                    <MudText Typo="Typo.body2" Class="@($"text-truncate {(item.IsRead ? "text-secondary font-weight-normal" : "font-weight-bold text-primary")}")">
                                        @item.Title
                                    </MudText>
                                    @if (!item.IsRead)
                                    {
                                        <span class="unread-dot"></span>
                                    }
                                </div>
                                <MudText Typo="Typo.caption" Class="d-block text-secondary message-clamp">
                                    @item.Message
                                </MudText>
                                <div class="d-flex align-center justify-space-between mt-1">
                                    <span class="text-caption text-secondary" style="font-size: 0.72rem;">
                                        @GetRelativeTime(item.CreatedAt)
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.ActionUrl))
                                    {
                                        <div class="d-flex align-center gap-1 action-link">
                                            <span style="font-size: 0.72rem; color: var(--mud-palette-primary);">View</span>
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Primary" Class="action-icon" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Panel Footer -->
    <div class="pa-2 text-center border-t border-solid" style="border-color: var(--mud-palette-lines-default) !important; background: rgba(var(--mud-palette-surface-rgb), 0.5);">
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.75rem;">
            Showing last @State.Notifications.Count notifications
        </MudText>
    </div>
</div>

<style>
    .notification-dropdown-panel {
        width: 380px;
        max-width: 90vw;
        background: var(--mud-palette-surface);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 14px;
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.22);
        overflow: hidden;
    }

    .mud-theme-dark .notification-dropdown-panel,
    .dark .notification-dropdown-panel {
        background: #111827 !important;
        border-color: rgba(255, 255, 255, 0.12) !important;
        box-shadow: 0 20px 40px -8px rgba(0, 0, 0, 0.75) !important;
    }

    .mud-theme-dark .notification-unread,
    .dark .notification-unread {
        background-color: rgba(129, 140, 248, 0.08) !important;
    }

    .notification-item {
        transition: background-color 0.18s ease;
        cursor: pointer;
    }

    .notification-item:hover {
        background-color: rgba(var(--mud-palette-primary-rgb), 0.06) !important;
    }

    .notification-unread {
        background-color: rgba(var(--mud-palette-primary-rgb), 0.035);
    }

    .notification-icon-wrapper {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .unread-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--mud-palette-primary);
        box-shadow: 0 0 6px var(--mud-palette-primary);
        display: inline-block;
        flex-shrink: 0;
    }

    .empty-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(var(--mud-palette-secondary-rgb), 0.08);
    }

    .message-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.35;
    }

    .action-icon {
        font-size: 0.85rem !important;
        transition: transform 0.2s ease;
    }

    .notification-item:hover .action-icon {
        transform: translateX(3px);
    }
</style>

@code {
    [Parameter]
    public int UnreadCount { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<int> OnUnreadCountChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += OnStateChanged;
        if (State.Notifications.Count == 0 && !State.IsLoading)
        {
            await State.LoadNotificationsAsync();
        }
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public async Task LoadNotificationsAsync()
    {
        await State.LoadNotificationsAsync();
        await OnUnreadCountChanged.InvokeAsync(State.UnreadCount);
    }

    private async Task MarkAllAsReadAsync()
    {
        try
        {
            await State.MarkAllAsReadAsync();
            Snackbar.Add("All notifications marked as read", Severity.Info);
            await OnUnreadCountChanged.InvokeAsync(State.UnreadCount);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnItemClick(NotificationDto item)
    {
        if (!item.IsRead)
        {
            await State.MarkAsReadAsync(item.Id);
            await OnUnreadCountChanged.InvokeAsync(State.UnreadCount);
        }

        await OnClose.InvokeAsync();

        if (!string.IsNullOrEmpty(item.ActionUrl))
        {
            Navigation.NavigateTo(item.ActionUrl);
        }
    }

    private string GetTypeIcon(NotificationType type)
    {
        return type switch
        {
            NotificationType.Success => Icons.Material.Filled.CheckCircle,
            NotificationType.Warning => Icons.Material.Filled.Warning,
            NotificationType.Error => Icons.Material.Filled.Error,
            _ => Icons.Material.Filled.Info
        };
    }

    private Color GetTypeColor(NotificationType type)
    {
        return type switch
        {
            NotificationType.Success => Color.Success,
            NotificationType.Warning => Color.Warning,
            NotificationType.Error => Color.Error,
            _ => Color.Info
        };
    }

    private string GetIconWrapperStyle(NotificationType type)
    {
        return type switch
        {
            NotificationType.Success => "background-color: rgba(16, 185, 129, 0.12);",
            NotificationType.Warning => "background-color: rgba(245, 158, 11, 0.12);",
            NotificationType.Error => "background-color: rgba(239, 68, 68, 0.12);",
            _ => "background-color: rgba(59, 130, 246, 0.12);"
        };
    }

    private string GetRelativeTime(DateTime createdAt)
    {
        var utcNow = DateTime.UtcNow;
        var itemUtc = createdAt.Kind == DateTimeKind.Utc ? createdAt : createdAt.ToUniversalTime();
        var span = utcNow - itemUtc;

        if (span.TotalSeconds < 60) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return itemUtc.ToString("MMM dd, yyyy");
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
