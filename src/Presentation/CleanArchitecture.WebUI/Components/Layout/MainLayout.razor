@inherits LayoutComponentBase
@implements IDisposable
@using CleanArchitecture.WebUI.Services
@using CleanArchitecture.WebUI.Components.Shared
@inject NotificationsClient NotificationsClient
@inject NotificationStateService NotificationState
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject AuthClient AuthClient
@inject TokenProvider TokenProvider
@inject IJSRuntime JSRuntime
@inject ThemeStateService ThemeState

<MudThemeProvider Theme="@ThemeState.CurrentTheme" IsDarkMode="@ThemeState.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout Class="@(ThemeState.IsDarkMode ? "mud-theme-dark dark" : "mud-theme-light light")">
    <MudAppBar Elevation="0" Class="glass-panel" Style="border-bottom: 1px solid var(--mud-palette-lines-default); height: 72px;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" Class="mr-2" Style="flex-shrink: 0;" />
        
        <!-- Brand Logo Area (flex-shrink: 0 prevents being crushed/hidden) -->
        <div class="d-flex align-center gap-2 gap-sm-3 cursor-pointer" style="flex-shrink: 0;" @onclick='() => NavigationManager.NavigateTo("")'>
            <div class="d-flex align-center justify-center rounded-xl" style="width: 36px; height: 36px; background: var(--primary-gradient); box-shadow: 0 4px 12px rgba(var(--mud-palette-primary-rgb), 0.35); flex-shrink: 0;">
                <MudIcon Icon="@Icons.Material.Filled.Layers" Style="color: white; font-size: 1.25rem;" />
            </div>
            <div style="flex-shrink: 0;">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-gradient-primary" Style="line-height: 1.1; letter-spacing: -0.02em;">CleanArch</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-none d-sm-block" Style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">Enterprise v1.8.0</MudText>
            </div>
        </div>

        <!-- API Online Status Pill (Show on Desktop only to prevent crowding) -->
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <div class="ml-4 pl-4 d-flex align-center" style="border-left: 1px solid var(--mud-palette-lines-default); flex-shrink: 0;">
                <div class="status-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.25);">
                    <span class="pulse-dot pulse-success"></span>
                    <span>API Online</span>
                </div>
            </div>
        </MudHidden>

        <!-- Command Palette Quick Search Pill (Desktop) -->
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <div class="ml-4 ml-lg-6" style="max-width: 260px; flex-shrink: 1;">
                <div class="command-palette-trigger d-flex align-center justify-space-between px-3 py-1-5 rounded-xl cursor-pointer"
                     @onclick="OpenCommandPalette"
                     role="button"
                     tabindex="0">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Rounded.Search" Size="Size.Small" />
                        <span class="py-1" style="font-size: 0.85rem;">Search or jump to...</span>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <span class="kbd-shortcut">Ctrl</span>
                        <span class="kbd-shortcut">K</span>
                    </div>
                </div>
            </div>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudIconButton Icon="@Icons.Material.Rounded.Search" Color="Color.Inherit" OnClick="OpenCommandPalette" Class="ml-1" Style="flex-shrink: 0;" />
        </MudHidden>

        <MudSpacer />

        <!-- Theme Preset Picker (Desktop/Tablet only; keeps mobile AppBar clean) -->
        <MudHidden Breakpoint="Breakpoint.Xs">
            <ThemePickerMenu />
        </MudHidden>
        <MudTooltip Text="@(ThemeState.IsDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
            <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" Class="mr-1" />
        </MudTooltip>
        
        <AuthorizeView Context="authContext">
            <Authorized>
                <!-- Notification Bell with Popover -->
                <div class="d-inline-flex align-center position-relative mr-2">
                    <MudBadge @key="NotificationState.UnreadCount"
                              Content="@(NotificationState.UnreadCount > 99 ? "99+" : NotificationState.UnreadCount)"
                              Color="Color.Error"
                              Overlap="true"
                              Class="notification-badge-pulse"
                              Visible="@(NotificationState.UnreadCount > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                                       Color="Color.Inherit"
                                       OnClick="ToggleNotificationPanelAsync" />
                    </MudBadge>

                    <MudOverlay Visible="_isNotificationOpen"
                                VisibleChanged="OnNotificationOverlayChanged"
                                AutoClose="true"
                                DarkBackground="false"
                                ZIndex="1290" />

                    <MudPopover Open="_isNotificationOpen"
                                AnchorOrigin="Origin.BottomRight"
                                TransformOrigin="Origin.TopRight"
                                Fixed="true"
                                Class="@($"notification-popover {(ThemeState.IsDarkMode ? "mud-theme-dark dark" : "mud-theme-light light")}")"
                                Style="margin-top: 10px; z-index: 1300; background: transparent; box-shadow: none;">
                        <NotificationPanel @ref="_notificationPanel"
                                           UnreadCount="NotificationState.UnreadCount"
                                           OnClose="CloseNotificationPanel"
                                           OnUnreadCountChanged="HandleUnreadCountChanged" />
                    </MudPopover>
                </div>

                <!-- User Profile Avatar & Menu (Fully Clickable Popover) -->
                <div class="position-relative">
                    <button type="button"
                            @onclick="ToggleUserMenu"
                            class="user-profile-btn d-flex align-center gap-1 rounded-pill px-2 py-1 cursor-pointer"
                            style="border: 1px solid var(--mud-palette-lines-default); background: rgba(var(--mud-palette-surface-rgb), 0.85); outline: none;">
                        <MudAvatar Color="Color.Primary" Size="Size.Small" Style="width: 26px; height: 26px; font-size: 0.75rem;" Class="mr-1">
                            @(string.IsNullOrEmpty(authContext.User.Identity?.Name) ? "U" : authContext.User.Identity.Name[0].ToString().ToUpperInvariant())
                        </MudAvatar>
                        <span class="font-weight-bold d-none d-sm-inline mr-1 text-truncate" style="max-width: 140px; font-size: 0.8125rem; color: var(--mud-palette-text-primary);">
                            @(authContext.User.Identity?.Name ?? "User")
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Style="opacity: 0.75; color: var(--mud-palette-text-secondary);" />
                    </button>

                    <MudOverlay Visible="_isUserMenuOpen"
                                VisibleChanged="OnUserMenuOverlayChanged"
                                AutoClose="true"
                                DarkBackground="false"
                                ZIndex="1290" />

                    <MudPopover Open="_isUserMenuOpen"
                                AnchorOrigin="Origin.BottomRight"
                                TransformOrigin="Origin.TopRight"
                                Fixed="true"
                                Class="@(ThemeState.IsDarkMode ? "mud-theme-dark dark user-menu-popover" : "mud-theme-light light user-menu-popover")"
                                Style="margin-top: 8px; z-index: 1300; min-width: 220px; border-radius: 14px; border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface) !important; color: var(--mud-palette-text-primary) !important; box-shadow: 0 12px 30px -5px rgba(0,0,0,0.35); overflow: hidden;">
                        <div class="pa-3 border-b border-solid" style="border-color: var(--mud-palette-lines-default) !important; background: var(--mud-palette-surface);">
                            <MudText Typo="Typo.body2" Class="font-weight-bold" Style="color: var(--mud-palette-text-primary) !important;">@(authContext.User.Identity?.Name)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Join(", ", TokenProvider.Roles)</MudText>
                        </div>
                        <MudList T="string" Dense="true" Style="background: var(--mud-palette-surface) !important; color: var(--mud-palette-text-primary) !important;">
                            <MudListItem Icon="@Icons.Material.Rounded.Dashboard" OnClick='() => { _isUserMenuOpen = false; NavigationManager.NavigateTo(""); }' Style="color: var(--mud-palette-text-primary) !important;">Dashboard</MudListItem>
                            <MudListItem Icon="@Icons.Material.Rounded.Inventory2" OnClick='() => { _isUserMenuOpen = false; NavigationManager.NavigateTo("products"); }' Style="color: var(--mud-palette-text-primary) !important;">Products</MudListItem>
                            @if (TokenProvider.Roles.Contains("Admin"))
                            {
                                <MudListItem Icon="@Icons.Material.Rounded.People" OnClick='() => { _isUserMenuOpen = false; NavigationManager.NavigateTo("users"); }' Style="color: var(--mud-palette-text-primary) !important;">Users & PBAC</MudListItem>
                                <MudListItem Icon="@Icons.Material.Rounded.Tune" OnClick='() => { _isUserMenuOpen = false; NavigationManager.NavigateTo("settings"); }' Style="color: var(--mud-palette-text-primary) !important;">App Settings</MudListItem>
                            }
                            <MudDivider Class="my-1" />
                            <MudListItem Icon="@Icons.Material.Rounded.Logout" IconColor="Color.Error" OnClick="LogoutAsync" Style="color: var(--mud-palette-error) !important;">Sign Out</MudListItem>
                        </MudList>
                    </MudPopover>
                </div>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Login"
                           OnClick='() => NavigationManager.NavigateTo("login")' Class="rounded-pill">
                    Sign In
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Class="mud-theme-drawer" Width="220px">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pb-10">
        <div class="main-content-container px-4 px-sm-5 px-md-6 pt-2">
            <AppBreadcrumbs />
            @Body
        </div>
    </MudMainContent>
    <CommandPalette @ref="_commandPalette" OnToggleDarkMode="DarkModeToggle" />
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private CancellationTokenSource? _cts;
    private NotificationPanel? _notificationPanel;
    private bool _isNotificationOpen = false;
    private bool _isUserMenuOpen = false;
    private CommandPalette? _commandPalette;

    private void OpenCommandPalette()
    {
        _commandPalette?.Open();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ThemeState.OnChange += OnThemeChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        NotificationState.OnChange += OnNotificationStateChanged;

        _cts = new CancellationTokenSource();
        _ = PollUnreadCountAsync(_cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeState.InitializeAsync();
            await NotificationState.RefreshAsync();
        }
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnNotificationStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = NotificationState.RefreshAsync();
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        InvokeAsync(async () =>
        {
            await NotificationState.RefreshAsync();
            StateHasChanged();
        });
    }

    private async Task ToggleNotificationPanelAsync()
    {
        _isNotificationOpen = !_isNotificationOpen;
        if (_isNotificationOpen)
        {
            await NotificationState.LoadNotificationsAsync();
        }
    }

    private void CloseNotificationPanel()
    {
        _isNotificationOpen = false;
    }

    private void OnNotificationOverlayChanged(bool visible)
    {
        _isNotificationOpen = visible;
    }

    private void ToggleUserMenu()
    {
        _isUserMenuOpen = !_isUserMenuOpen;
    }

    private void OnUserMenuOverlayChanged(bool visible)
    {
        _isUserMenuOpen = visible;
    }

    private void HandleUnreadCountChanged(int newCount)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task PollUnreadCountAsync(CancellationToken ct)
    {
        await NotificationState.RefreshAsync();

        try
        {
            using var periodicTimer = new PeriodicTimer(TimeSpan.FromSeconds(15));
            while (await periodicTimer.WaitForNextTickAsync(ct))
            {
                await NotificationState.RefreshAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Normal shutdown
        }
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task DarkModeToggle()
    {
        await ThemeState.ToggleDarkModeAsync();
    }

    private async Task LogoutAsync()
    {
        await AuthClient.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }

    public string DarkLightModeButtonIcon => ThemeState.IsDarkMode switch
    {
        true => Icons.Material.Rounded.LightMode,
        false => Icons.Material.Outlined.DarkMode,
    };

    public void Dispose()
    {
        ThemeState.OnChange -= OnThemeChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
        NotificationState.OnChange -= OnNotificationStateChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}

<style>
    .notification-badge-pulse .mud-badge {
        animation: notification-badge-bounce 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @@keyframes notification-badge-bounce {
        0% { transform: scale(0.6); }
        60% { transform: scale(1.22); }
        100% { transform: scale(1); }
    }
</style>


