@inherits LayoutComponentBase
@implements IDisposable
@using CleanArchitecture.WebUI.Services
@inject NotificationsClient NotificationsClient
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="0" Style="background: var(--mud-palette-appbar-background); backdrop-filter: blur(12px); border-bottom: 1px solid var(--mud-palette-lines-default);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3 font-weight-bold" Color="Color.Primary">Application</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
        
        <AuthorizeView>
            <Authorized>
                <div class="d-inline-flex align-center position-relative ml-2">
                    <MudBadge Content="@(_unreadCount > 99 ? "99+" : _unreadCount)"
                              Color="Color.Error"
                              Overlap="true"
                              Visible="@(_unreadCount > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                                       Color="Color.Inherit"
                                       Edge="Edge.End"
                                       OnClick="ToggleNotificationPanelAsync" />
                    </MudBadge>

                    <MudOverlay Visible="_isNotificationOpen"
                                VisibleChanged="OnNotificationOverlayChanged"
                                AutoClose="true"
                                DarkBackground="false"
                                ZIndex="1290" />

                    <MudPopover Open="_isNotificationOpen"
                                AnchorOrigin="Origin.BottomRight"
                                TransformOrigin="Origin.TopRight"
                                Fixed="true"
                                Class="notification-popover"
                                Style="margin-top: 10px; z-index: 1300; background: transparent; box-shadow: none;">
                        <NotificationPanel @ref="_notificationPanel"
                                           UnreadCount="_unreadCount"
                                           OnClose="CloseNotificationPanel"
                                           OnUnreadCountChanged="HandleUnreadCountChanged" />
                    </MudPopover>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="mt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MudTheme? _theme = null;
    private int _unreadCount = 0;
    private CancellationTokenSource? _cts;
    private NotificationPanel? _notificationPanel;
    private bool _isNotificationOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            Typography = _typography,
            LayoutProperties = new LayoutProperties
            {
                DefaultBorderRadius = "12px",
                AppbarHeight = "72px"
            }
        };

        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        _cts = new CancellationTokenSource();
        _ = PollUnreadCountAsync(_cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshUnreadCountAsync();
        }
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        InvokeAsync(async () =>
        {
            await RefreshUnreadCountAsync();
            StateHasChanged();
        });
    }

    private async Task ToggleNotificationPanelAsync()
    {
        _isNotificationOpen = !_isNotificationOpen;
        if (_isNotificationOpen && _notificationPanel != null)
        {
            await _notificationPanel.LoadNotificationsAsync();
        }
    }

    private void CloseNotificationPanel()
    {
        _isNotificationOpen = false;
    }

    private void OnNotificationOverlayChanged(bool visible)
    {
        _isNotificationOpen = visible;
    }

    private void HandleUnreadCountChanged(int newCount)
    {
        _unreadCount = newCount;
        StateHasChanged();
    }

    private async Task PollUnreadCountAsync(CancellationToken ct)
    {
        await RefreshUnreadCountAsync();

        try
        {
            using var periodicTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await periodicTimer.WaitForNextTickAsync(ct))
            {
                await RefreshUnreadCountAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Normal shutdown
        }
    }

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated == true)
            {
                var result = await NotificationsClient.GetUnreadCountAsync();
                if (result.IsSuccess)
                {
                    _unreadCount = result.Data;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch
        {
            // Ignore background polling errors
        }
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#4f46e5",
        PrimaryDarken = "#4338ca",
        PrimaryLighten = "#818cf8",
        Secondary = "#64748b",
        Black = "#0f172a",
        AppbarText = "#334155",
        AppbarBackground = "rgba(255,255,255,0.7)",
        DrawerBackground = "#ffffff",
        GrayLight = "#f1f5f9",
        GrayLighter = "#f8fafc",
        Background = "#f8fafc",
        Surface = "#ffffff",
        Success = "#10b981",
        Warning = "#f59e0b",
        Error = "#ef4444",
        Info = "#3b82f6",
        BackgroundGray = "#f1f5f9",
        LinesDefault = "#e2e8f0",
        Divider = "#e2e8f0"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#818cf8",
        PrimaryLighten = "#a5b4fc",
        PrimaryDarken = "#4f46e5",
        Secondary = "#94a3b8",
        Surface = "#1e293b",
        Background = "#0f172a",
        BackgroundGray = "#0f172a",
        AppbarText = "#f8fafc",
        AppbarBackground = "rgba(15,23,42,0.8)",
        DrawerBackground = "#1e293b",
        ActionDefault = "#94a3b8",
        ActionDisabled = "#475569",
        ActionDisabledBackground = "#334155",
        TextPrimary = "#f1f5f9",
        TextSecondary = "#94a3b8",
        TextDisabled = "#64748b",
        DrawerIcon = "#cbd5e1",
        DrawerText = "#f1f5f9",
        GrayLight = "#334155",
        GrayLighter = "#1e293b",
        Info = "#3b82f6",
        Success = "#10b981",
        Warning = "#f59e0b",
        Error = "#ef4444",
        LinesDefault = "#334155",
        TableLines = "#334155",
        Divider = "#334155",
        OverlayLight = "#0f172a80",
    };

    private readonly Typography _typography = new()
    {
        Default = new DefaultTypography()
        {
            FontFamily = new[] { "Inter", "Helvetica", "Arial", "sans-serif" },
            FontSize = "0.95rem",
            LetterSpacing = "0.01em"
        },
        H1 = new H1Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "700" },
        H2 = new H2Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "700" },
        H3 = new H3Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "700" },
        H4 = new H4Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "600" },
        H5 = new H5Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "600" },
        H6 = new H6Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "600" },
        Button = new ButtonTypography { FontFamily = new[] { "Inter", "sans-serif" }, FontWeight = "600", TextTransform = "none" },
        Subtitle1 = new Subtitle1Typography { FontFamily = new[] { "Inter", "sans-serif" }, FontWeight = "500" }
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}


