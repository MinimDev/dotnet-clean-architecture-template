@inherits LayoutComponentBase
@implements IDisposable
@using CleanArchitecture.WebUI.Services
@inject NotificationsClient NotificationsClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject AuthClient AuthClient
@inject TokenProvider TokenProvider

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar Elevation="0" Class="glass-panel" Style="border-bottom: 1px solid var(--mud-palette-lines-default); height: 72px;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" Class="mr-2" />
        
        <!-- Brand Logo Area -->
        <div class="d-flex align-center gap-3 cursor-pointer" @onclick='() => NavigationManager.NavigateTo("")'>
            <div class="d-flex align-center justify-center rounded-xl" style="width: 38px; height: 38px; background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); box-shadow: 0 4px 14px rgba(79, 70, 229, 0.4);">
                <MudIcon Icon="@Icons.Material.Filled.Layers" Style="color: white; font-size: 1.35rem;" />
            </div>
            <div>
                <MudText Typo="Typo.h6" Class="font-weight-bold text-gradient-primary" Style="line-height: 1.1; letter-spacing: -0.02em;">CleanArch</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">Enterprise v1.7.0</MudText>
            </div>
        </div>

        <MudHidden Breakpoint="Breakpoint.Xs">
            <div class="ml-4 pl-4 d-flex align-center" style="border-left: 1px solid var(--mud-palette-lines-default);">
                <div class="status-pill" style="background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.25);">
                    <span class="pulse-dot pulse-success"></span>
                    <span>API Online</span>
                </div>
            </div>
        </MudHidden>

        <MudSpacer />

        <!-- Theme Mode Toggle -->
        <MudTooltip Text="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
            <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" Class="mr-1" />
        </MudTooltip>
        
        <AuthorizeView Context="authContext">
            <Authorized>
                <!-- Notification Bell with Popover -->
                <div class="d-inline-flex align-center position-relative mr-2">
                    <MudBadge Content="@(_unreadCount > 99 ? "99+" : _unreadCount)"
                              Color="Color.Error"
                              Overlap="true"
                              Visible="@(_unreadCount > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                                       Color="Color.Inherit"
                                       OnClick="ToggleNotificationPanelAsync" />
                    </MudBadge>

                    <MudOverlay Visible="_isNotificationOpen"
                                VisibleChanged="OnNotificationOverlayChanged"
                                AutoClose="true"
                                DarkBackground="false"
                                ZIndex="1290" />

                    <MudPopover Open="_isNotificationOpen"
                                AnchorOrigin="Origin.BottomRight"
                                TransformOrigin="Origin.TopRight"
                                Fixed="true"
                                Class="notification-popover"
                                Style="margin-top: 10px; z-index: 1300; background: transparent; box-shadow: none;">
                        <NotificationPanel @ref="_notificationPanel"
                                           UnreadCount="_unreadCount"
                                           OnClose="CloseNotificationPanel"
                                           OnUnreadCountChanged="HandleUnreadCountChanged" />
                    </MudPopover>
                </div>

                <!-- User Profile Avatar & Menu -->
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="false">
                    <ActivatorContent Context="menuActivatorContext">
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Class="pa-1 pl-2 pr-3 cursor-pointer rounded-pill" Style="border: 1px solid var(--mud-palette-lines-default);">
                            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">
                                @(string.IsNullOrEmpty(authContext.User.Identity?.Name) ? "U" : authContext.User.Identity.Name[0].ToString().ToUpperInvariant())
                            </MudAvatar>
                            <span class="font-weight-bold mr-1">@(authContext.User.Identity?.Name ?? "User")</span>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="pa-3" style="min-width: 200px;">
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@(authContext.User.Identity?.Name)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Join(", ", TokenProvider.Roles)</MudText>
                        </div>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Dashboard" OnClick='() => NavigationManager.NavigateTo("")'>Dashboard</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Inventory" OnClick='() => NavigationManager.NavigateTo("products")'>Products</MudMenuItem>
                        @if (TokenProvider.Roles.Contains("Admin"))
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.People" OnClick='() => NavigationManager.NavigateTo("users")'>Users & PBAC</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Tune" OnClick='() => NavigationManager.NavigateTo("settings")'>App Settings</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="LogoutAsync">Sign Out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Login"
                           OnClick='() => NavigationManager.NavigateTo("login")' Class="rounded-pill">
                    Sign In
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Class="mud-theme-drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="mt-16 pa-4 pa-sm-6">
        @Body
    </MudMainContent>
</MudLayout>


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MudTheme? _theme = null;
    private int _unreadCount = 0;
    private CancellationTokenSource? _cts;
    private NotificationPanel? _notificationPanel;
    private bool _isNotificationOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            Typography = _typography,
            LayoutProperties = new LayoutProperties
            {
                DefaultBorderRadius = "12px",
                AppbarHeight = "72px"
            }
        };

        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        _cts = new CancellationTokenSource();
        _ = PollUnreadCountAsync(_cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshUnreadCountAsync();
        }
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        InvokeAsync(async () =>
        {
            await RefreshUnreadCountAsync();
            StateHasChanged();
        });
    }

    private async Task ToggleNotificationPanelAsync()
    {
        _isNotificationOpen = !_isNotificationOpen;
        if (_isNotificationOpen && _notificationPanel != null)
        {
            await _notificationPanel.LoadNotificationsAsync();
        }
    }

    private void CloseNotificationPanel()
    {
        _isNotificationOpen = false;
    }

    private void OnNotificationOverlayChanged(bool visible)
    {
        _isNotificationOpen = visible;
    }

    private void HandleUnreadCountChanged(int newCount)
    {
        _unreadCount = newCount;
        StateHasChanged();
    }

    private async Task PollUnreadCountAsync(CancellationToken ct)
    {
        await RefreshUnreadCountAsync();

        try
        {
            using var periodicTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await periodicTimer.WaitForNextTickAsync(ct))
            {
                await RefreshUnreadCountAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Normal shutdown
        }
    }

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated == true)
            {
                var result = await NotificationsClient.GetUnreadCountAsync();
                if (result.IsSuccess)
                {
                    _unreadCount = result.Data;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch
        {
            // Ignore background polling errors
        }
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private async Task LogoutAsync()
    {
        await AuthClient.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#4f46e5",
        PrimaryDarken = "#4338ca",
        PrimaryLighten = "#818cf8",
        Secondary = "#64748b",
        Black = "#0f172a",
        AppbarText = "#1e293b",
        AppbarBackground = "rgba(255,255,255,0.85)",
        DrawerBackground = "#ffffff",
        GrayLight = "#f1f5f9",
        GrayLighter = "#f8fafc",
        Background = "#f8fafc",
        Surface = "#ffffff",
        Success = "#10b981",
        Warning = "#f59e0b",
        Error = "#ef4444",
        Info = "#3b82f6",
        BackgroundGray = "#f1f5f9",
        LinesDefault = "#e2e8f0",
        Divider = "#e2e8f0"
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#818cf8",
        PrimaryLighten = "#a5b4fc",
        PrimaryDarken = "#4f46e5",
        Secondary = "#94a3b8",
        Surface = "#111827",
        Background = "#090d16",
        BackgroundGray = "#0f172a",
        AppbarText = "#f8fafc",
        AppbarBackground = "rgba(11, 15, 25, 0.85)",
        DrawerBackground = "#0d131f",
        ActionDefault = "#94a3b8",
        ActionDisabled = "#475569",
        ActionDisabledBackground = "#1f293d",
        TextPrimary = "#f1f5f9",
        TextSecondary = "#94a3b8",
        TextDisabled = "#64748b",
        DrawerIcon = "#cbd5e1",
        DrawerText = "#f1f5f9",
        GrayLight = "#1f293d",
        GrayLighter = "#111827",
        Info = "#38bdf8",
        Success = "#34d399",
        Warning = "#fbbf24",
        Error = "#f87171",
        LinesDefault = "#1f293d",
        TableLines = "#1f293d",
        Divider = "#1f293d",
        OverlayLight = "#090d1680",
    };

    private readonly Typography _typography = new()
    {
        Default = new DefaultTypography()
        {
            FontFamily = new[] { "Inter", "Helvetica", "Arial", "sans-serif" },
            FontSize = "0.95rem",
            LetterSpacing = "0.01em"
        },
        H1 = new H1Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "700" },
        H2 = new H2Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "700" },
        H3 = new H3Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "700" },
        H4 = new H4Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "600" },
        H5 = new H5Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "600" },
        H6 = new H6Typography { FontFamily = new[] { "Outfit", "sans-serif" }, FontWeight = "600" },
        Button = new ButtonTypography { FontFamily = new[] { "Inter", "sans-serif" }, FontWeight = "600", TextTransform = "none" },
        Subtitle1 = new Subtitle1Typography { FontFamily = new[] { "Inter", "sans-serif" }, FontWeight = "500" }
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.LightMode,
        false => Icons.Material.Outlined.DarkMode,
    };

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}


